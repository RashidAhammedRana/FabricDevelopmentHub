@model FabricDevelopmentHub.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fabric Development & Innovation HUB - Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            overflow: hidden;
            font-family: "Segoe UI", Arial, sans-serif;
        }


        /* =========================================================
                   MAIN LOGIN PAGE
                ========================================================= */

        .login-page {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            /*
                        IMPORTANT:
                        Background image remains CLEAR.
                        No blur and no dark overlay.
                    */

            background-image: url('/images/UtilityManagement_BG.png');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
        }


            /* =========================================================
                   NO BACKGROUND OVERLAY

                   Keeping this transparent means the BG image
                   will remain sharp and original.
                ========================================================= */

        .login-card {
            position: relative;
            z-index: 2;
            width: 450px;
            padding: 38px 42px;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 20px 50px rgba(0, 50, 70, 0.25), 0 5px 15px rgba(0, 0, 0, 0.12);
            color: #173b4d;
            overflow: hidden;
            transform: translateX(120px);
        }


            .login-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 6px;
                border-radius: 22px 22px 0 0;
                background: linear-gradient( 90deg, #087f8c 0%, #16a085 50%, #3aa6d0 100% );
            }


            /* =========================================================
                   TOP ACCENT
                ========================================================= */

            .login-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 5px;
                border-radius: 22px 22px 0 0;
                background: linear-gradient( 90deg, #087f8c, #16a085, #3aa6d0 );
            }


        /* =========================================================
                   LOGO
                ========================================================= */

        .logo {
            display: block;
            margin: 0 auto 18px auto;
            max-width: 150px;
            max-height: 70px;
            object-fit: contain;
        }


        /* =========================================================
                   ICON / BRAND MARK
                ========================================================= */

        .login-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 18px auto;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient( 135deg, #087f8c, #16a085 );
            color: white;
            font-size: 25px;
            box-shadow: 0 8px 20px rgba(8, 127, 140, 0.25);
        }


        /* =========================================================
                   TITLE
                ========================================================= */

        .login-title {
            font-size: 25px;
            font-weight: 700;
            text-align: center;
            margin: 0;
            color: #123d50;
            letter-spacing: -0.3px;
        }


        /* =========================================================
                   SUBTITLE
                ========================================================= */

        .login-subtitle {
            text-align: center;
            font-size: 14px;
            margin-top: 8px;
            margin-bottom: 28px;
            color: #64808c;
        }


        /* =========================================================
                   FORM GROUP
                ========================================================= */

        .form-group-custom {
            margin-bottom: 20px;
        }


        /* =========================================================
                   LABEL
                ========================================================= */

        .form-label-custom {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #315767;
            margin-bottom: 7px;
        }


        /* =========================================================
                   INPUT WRAPPER
                ========================================================= */

        .input-wrapper {
            position: relative;
        }


        /* =========================================================
                   INPUT ICON
                ========================================================= */

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6d929e;
            font-size: 15px;
            z-index: 3;
        }


        /* =========================================================
                   INPUT
                ========================================================= */

        .form-control {
            height: 48px;
            padding-left: 43px;
            padding-right: 15px;
            border-radius: 10px;
            border: 1px solid #d5e2e7;
            background: #f8fbfc;
            color: #234858;
            font-size: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }


            .form-control::placeholder {
                color: #9aadb5;
            }


            .form-control:hover {
                border-color: #b8d0d8;
                background: #ffffff;
            }


            .form-control:focus {
                outline: none;
                background: #ffffff;
                color: #234858;
                border-color: #1596a5;
                box-shadow: 0 0 0 3px rgba(21, 150, 165, 0.12);
            }


        /* =========================================================
                   PASSWORD TOGGLE
                ========================================================= */

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #7d979f;
            cursor: pointer;
            font-size: 14px;
            z-index: 3;
        }

            .password-toggle:hover {
                color: #087f8c;
            }


        /* =========================================================
                   REMEMBER ME
                ========================================================= */

        .remember-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 5px;
            margin-bottom: 24px;
        }


        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
        }


            .remember-me .form-check-input {
                width: 17px;
                height: 17px;
                margin: 0;
                cursor: pointer;
                border-color: #b7cdd4;
            }


                .remember-me .form-check-input:checked {
                    background-color: #087f8c;
                    border-color: #087f8c;
                }


            .remember-me label {
                font-size: 13px;
                color: #617d87;
                cursor: pointer;
            }


        /* =========================================================
                   LOGIN BUTTON
                ========================================================= */

        .btn-login {
            width: 100%;
            height: 49px;
            border: none;
            border-radius: 10px;
            background: linear-gradient( 135deg, #087f8c, #1596a5 );
            color: white;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.2px;
            box-shadow: 0 8px 18px rgba(8, 127, 140, 0.25);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }


            .btn-login:hover {
                background: linear-gradient( 135deg, #066d78, #0f8795 );
                transform: translateY(-1px);
                box-shadow: 0 10px 22px rgba(8, 127, 140, 0.32);
                color: white;
            }


            .btn-login:active {
                transform: translateY(0);
            }


            /* =========================================================
                   LOGIN BUTTON ICON
                ========================================================= */

            .btn-login i {
                margin-right: 8px;
                font-size: 13px;
            }


        /* =========================================================
                   VALIDATION
                ========================================================= */

        .validation-summary {
            margin-bottom: 15px;
        }

        .text-danger {
            font-size: 12px;
        }


        /* =========================================================
                   FOOTER
                ========================================================= */

        .login-footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid #e5edef;
            color: #8aa0a8;
            font-size: 11px;
            letter-spacing: 0.3px;
        }


            .login-footer strong {
                color: #4d7581;
            }


        /* =========================================================
                   TOAST
                ========================================================= */

        #toast-container {
            z-index: 999999 !important;
        }


        .toast-success {
            background-color: #198754 !important;
            color: white !important;
            font-weight: 600;
        }


        .toast-error {
            background-color: #dc3545 !important;
            color: white !important;
            font-weight: 600;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 992px) {
            .login-card

        {
            transform: translateX(0);
            width: 440px;
        }

        }


        @@media (max-width: 768px) {
            .login-page

        {
            background-position: center center;
        }

        .login-card {
            width: calc(100% - 40px);
            max-width: 450px;
            padding: 32px 28px;
            transform: translateX(0);
        }

        .login-title {
            font-size: 22px;
        }

        }


        @@media (max-width: 480px) {
            .login-card

        {
            width: calc(100% - 30px);
            padding: 30px 22px;
        }

        .login-title {
            font-size: 20px;
        }

        .login-subtitle {
            margin-bottom: 22px;
        }

        }
    </style>
</head>


<body>

    <div class="login-page">

        <div class="login-card">

            <!-- =====================================================
                 LOGO
            ====================================================== -->
            @* 
            <img src="~/images/cotton_club_bd_ltd.jpg"
                 class="logo"
                 alt="Company Logo" />
            *@


            <!-- =====================================================
                 ICON
            ====================================================== -->

            <div class="login-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>


            <!-- =====================================================
                 TITLE
            ====================================================== -->

            <h4 class="login-title">
                Fabric Development &amp; Innovation HUB
            </h4>


            <p class="login-subtitle">
                Welcome back. Please sign in to continue.
            </p>


            <!-- =====================================================
                 LOGIN FORM
            ====================================================== -->

            <form asp-action="Login"
                  method="post"
                  autocomplete="on">


                <!-- VALIDATION -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary">
                </div>


                <!-- =================================================
                     USERNAME
                ================================================== -->

                <div class="form-group-custom">

                    <label class="form-label-custom">
                        Username
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-user input-icon"></i>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="username"
                               placeholder="Enter your username" />

                    </div>

                </div>


                <!-- =================================================
                     PASSWORD
                ================================================== -->

                <div class="form-group-custom">

                    <label class="form-label-custom">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-lock input-icon"></i>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               id="password"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               style="padding-right:45px;" />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                tabindex="-1">

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                </div>


                <!-- =================================================
                     REMEMBER ME
                ================================================== -->

                <div class="remember-row">

                    <div class="remember-me">

                        <input asp-for="RememberMe"
                               class="form-check-input"
                               id="rememberMe" />

                        <label for="rememberMe">
                            Remember Me
                        </label>

                    </div>

                </div>


                <!-- =================================================
                     LOGIN BUTTON
                ================================================== -->

                <button type="submit"
                        class="btn btn-login">

                    <i class="fa-solid fa-right-to-bracket"></i>

                    Login

                </button>


            </form>


            <!-- =====================================================
                 FOOTER
            ====================================================== -->

            <div class="login-footer">

                <strong>Fabric Development &amp; Innovation HUB</strong>

                <br />

                Turning Ideas into Better Fabrics

            </div>

        </div>

    </div>


    <!-- =========================================================
         PASSWORD SHOW / HIDE
    ========================================================== -->

    <script>

        $(function () {

            /* ---------------------------------------------
               Password Show / Hide
            --------------------------------------------- */

            $("#togglePassword").on("click", function () {

                var password = $("#password");

                var icon = $(this).find("i");

                if (password.attr("type") === "password") {

                    password.attr("type", "text");

                    icon.removeClass("fa-eye")
                        .addClass("fa-eye-slash");

                }
                else {

                    password.attr("type", "password");

                    icon.removeClass("fa-eye-slash")
                        .addClass("fa-eye");

                }

            });


            /* ---------------------------------------------
               Toastr
            --------------------------------------------- */

            toastr.options = {

                closeButton: true,

                progressBar: true,

                positionClass: "toast-top-right",

                timeOut: 1500,

                extendedTimeOut: 500,

                newestOnTop: true,

                preventDuplicates: true

            };


            var successMessage =
                "@(TempData["SuccessMessage"] as string ?? "")";


            var errorMessage =
                "@(TempData["ErrorMessage"] as string ?? "")";


            if (successMessage.length > 0) {

                toastr.success(
                    successMessage,
                    "Success"
                );

            }


            if (errorMessage.length > 0) {

                toastr.error(
                    errorMessage,
                    "Error"
                );

            }

        });

    </script>

</body>
</html>