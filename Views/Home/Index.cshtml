                </p>

            </a>

        </div>

    </section>


    <!-- ================================
         FOCUS AREAS
    ================================= -->

    <section class="hub-section">

        <div class="hub-info-grid">


            <div class="hub-info-card">

                <h4>
                    <i class="bi bi-bullseye me-2"></i>
                    Current Focus Areas
                </h4>


                <div class="hub-focus-item">

                    <div class="hub-focus-icon">
                        <i class="bi bi-layers"></i>
                    </div>

                    <div class="hub-focus-text">
                        <strong>Advanced Fabric Development</strong>
                        <span>Developing improved fabric structures and constructions</span>
                    </div>

                </div>


                <div class="hub-focus-item">

                    <div class="hub-focus-icon">
                        <i class="bi bi-droplet"></i>
                    </div>

                    <div class="hub-focus-text">
                        <strong>Resource Efficiency</strong>
                        <span>Reducing water, energy and material consumption</span>
                    </div>

                </div>


                <div class="hub-focus-item">

                    <div class="hub-focus-icon">
                        <i class="bi bi-speedometer2"></i>
                    </div>

                    <div class="hub-focus-text">
                        <strong>Performance Improvement</strong>
                        <span>Improving fabric quality, durability and performance</span>
                    </div>

                </div>


                <div class="hub-focus-item">

                    <div class="hub-focus-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div class="hub-focus-text">
                        <strong>Innovation &amp; Collaboration</strong>
                        <span>Connecting ideas, people and technical expertise</span>
                    </div>

                </div>

            </div>


            <div class="hub-info-card">

                <h4>
                    <i class="bi bi-grid-3x3-gap me-2"></i>
                    HUB Capabilities
                </h4>

                <div>

                    <span class="hub-tag">Fabric Development</span>
                    <span class="hub-tag">R&amp;D</span>
                    <span class="hub-tag">Innovation</span>
                    <span class="hub-tag">Quality</span>
                    <span class="hub-tag">Performance</span>
                    <span class="hub-tag">Sustainability</span>
                    <span class="hub-tag">Testing</span>
                    <span class="hub-tag">Analytics</span>
                    <span class="hub-tag">Technical Support</span>
                    <span class="hub-tag">Collaboration</span>

                </div>

            </div>

        </div>

    </section>


</div>