
@model IEnumerable<FabricDevelopmentHub.Models.TblLabTestParameter>

@{
    ViewData["Title"] = "Lab Test Parameter List";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;

    int pageSize = 15;
    int sl = (currentPage - 1) * pageSize;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);

    bool canCreate = ViewBag.CanCreate ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
    bool canDelete = ViewBag.CanDelete ?? false;
}

<h2 class="text-center">Lab Test Parameter List</h2>

<p class="text-muted text-center">
    Total Parameters: <strong>@ViewBag.TotalParameters</strong>
</p>

<!-- ================= HEADER ================= -->

<div class="d-flex justify-content-between align-items-center mb-3">

    <!-- SEARCH LEFT -->
    <form method="get"
          asp-action="LabTestParameterList"
          class="d-flex gap-2 align-items-center flex-grow-1">

        <input type="text"
               name="searchString"
               id="searchBox"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search parameter..."
               style="max-width:350px;" />

    </form>

    <!-- ACTION BUTTONS -->
    <div class="d-flex gap-2">

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create
            </a>
        }

        <button type="button"
                class="btn btn-secondary"
                onclick="window.history.back();">
            Back
        </button>

    </div>

</div>

<!-- ================= TABLE ================= -->

<div class="table-responsive">

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-info text-center">
            <tr>
                <th>SL</th>
                <th>Parameter Group</th>
                <th>Parameter Name</th>
                <th>Display Order</th>
                <th>Status</th>

                @if (canEdit || canDelete)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    sl++;

                    <tr class="text-center">

                        <td>@sl</td>

                        <td>@item.ParameterGroup</td>

                        <td>@item.ParameterName</td>

                        <td>@item.DisplayOrder</td>
                        <td>@item.Status</td>

                        @* <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td> *@

                        @if (canEdit || canDelete)
                        {
                            <td>
                                <div class="btn-group btn-group-sm gap-2">

                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.ParameterId"
                                           class="btn btn-success">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                    }

                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@item.ParameterId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this parameter?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>
                        }

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No Lab Test Parameters Found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

<!-- ================= PAGINATION ================= -->

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center flex-wrap">

            <!-- PREVIOUS -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                <a class="page-link"
                   href="@Url.Action("LabTestParameterList", new {
                       page = currentPage - 1,
                       searchString = ViewBag.SearchString
                   })">
                    Previous
                </a>

            </li>

            <!-- PAGE NUMBERS -->
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">

                    <a class="page-link"
                       href="@Url.Action("LabTestParameterList", new {
                           page = i,
                           searchString = ViewBag.SearchString
                       })">
                        @i
                    </a>

                </li>
            }

            <!-- NEXT -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                <a class="page-link"
                   href="@Url.Action("LabTestParameterList", new {
                       page = currentPage + 1,
                       searchString = ViewBag.SearchString
                   })">
                    Next
                </a>

            </li>

        </ul>
    </nav>
}

<!-- ================= AUTO SEARCH ================= -->

<script>

    let timer;

    const searchBox = document.getElementById("searchBox");

    if (searchBox) {

        searchBox.addEventListener("input", function () {

            clearTimeout(timer);

            timer = setTimeout(() => {

                let url = new URL(window.location.href);

                if (this.value.trim()) {
                    url.searchParams.set("searchString", this.value.trim());
                }
                else {
                    url.searchParams.delete("searchString");
                }

                url.searchParams.set("page", 1);

                window.location.href = url.toString();

            }, 500);

        });

        // Focus + cursor position
        window.onload = function () {

            searchBox.focus();

            let val = searchBox.value;

            searchBox.value = "";

            searchBox.value = val;

        };

    }

</script>
