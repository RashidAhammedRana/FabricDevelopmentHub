@model IEnumerable<FabricDevelopmentHub.Models.TblFtdMaster>

@{
    ViewData["Title"] = "FTD List";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int pageSize = ViewBag.PageSize ?? 30;

    string searchString = ViewBag.SearchString ?? "";

    bool canView = ViewBag.CanView == true;
    bool canCreate = ViewBag.CanCreate == true;
    bool canEdit = ViewBag.CanEdit == true;
    bool canDelete = ViewBag.CanDelete == true;

    int startRecord = totalRecords == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    int endRecord = Math.Min(currentPage * pageSize, totalRecords);
}

<div class="step-content active" id="step-1">

    <div class="ftd-section mt-0">

        <!-- HEADER -->
        <div class="ftd-section-header">

            <h3 class="ftd-section-title mb-0">
                <strong>FTD Information List</strong>
            </h3>

        </div>

        <!-- TOTAL RECORDS + CREATE BUTTON -->

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2 mb-2">

            <small style="color: #666666;">
                <strong>Total Records: @totalRecords </strong>
            </small>

            @if (canCreate)
            {
                <a asp-action="Create"
                   class="btn btn-primary btn-sm"
                   id="createNewBtn"
                   onclick="showCreateLoader(this)">

                    <i class="bi bi-plus-circle"></i>
                    Create New

                </a>
            }
        </div>
        <hr class="ftd-section-line" />

        @if (!canView)
        {
            <div class="alert alert-danger">
                You do not have permission to view FTD records.
            </div>
        }
        else
        {
            <!-- SEARCH SECTION -->

            <form asp-action="FTDList"
                  method="get"
                  class="mb-3">

                <div class="row g-2 align-items-center">

                    <div class="col-lg-4 col-md-6">

                        <input type="text"
                               name="searchString"
                               value="@searchString"
                               class="form-control"
                               placeholder="Search FTD, Control, Company, Buyer, Style..." />

                    </div>

                    <div class="col-auto">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search"></i>
                            Search

                        </button>

                    </div>

                    <div class="col-auto">

                        <a asp-action="FTDList"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset

                        </a>

                    </div>

                </div>

            </form>

            <!-- MASTER INFORMATION TABLE -->

            <div class="table-responsive">

                <table class="table table-bordered table-hover table-striped align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>FTD No.</th>

                            <th>LC Company</th>

                            <th>Control No.</th>

                            <th>Batch No.</th>

                            <th>Sys. Req.</th>

                            <th>Buyer</th>

                            <th>Style Ref.</th>

                            <th class="text-center"
                                style="min-width: 160px;">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.FtdNo
                                    </td>

                                    <td>
                                        @item.Company
                                    </td>

                                    <td>
                                        @item.Control
                                    </td>

                                    <td>
                                        @item.BatchNo
                                    </td>

                                    <td>
                                        @item.SysReq
                                    </td>

                                    <td>
                                        @item.Buyer
                                    </td>

                                    <td>
                                        @item.StyleRef
                                    </td>

                                    <!-- ACTION COLUMN -->

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center align-items-center gap-2">

                                            @if (canView)
                                            {
                                                <a asp-action="Details"
                                                   asp-route-id="@item.Ftdid"
                                                   class="btn btn-info btn-sm">

                                                    <i class="bi bi-eye"></i>
                                                    Details

                                                </a>
                                            }
                                            @if (canEdit)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Ftdid"
                                                   class="btn btn-success btn-sm">

                                                    <i class="bi bi-pencil-square"></i>
                                                    Edit

                                                </a>
                                            }

                                            @if (canDelete)
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@item.FtdNo"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this record?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">

                                                        <i class="bi bi-trash"></i>
                                                        Delete

                                                    </button>

                                                </form>
                                            }

                                            @if (!canEdit && !canDelete)
                                            {
                                                <span class="text-muted small">
                                                    No Action
                                                </span>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                    No master information found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- FOOTER: RECORD INFO + PAGINATION -->

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">

                <!-- RECORD INFORMATION -->

                <div class="small" style="color: #666666;">

                    Showing
                    <strong>@startRecord</strong>
                    to
                    <strong>@endRecord</strong>
                    of
                    <strong>@totalRecords</strong>
                    records

                </div>

                <!-- PREVIOUS / CURRENT PAGE / NEXT -->
                @if (totalPages > 0)
                {
                    <nav aria-label="FTD pagination">

                        <ul class="pagination pagination-sm mb-0">

                            <!-- PREVIOUS -->

                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                                @if (currentPage > 1)
                                {
                                    <a class="page-link"
                                       asp-action="FTDList"
                                       asp-route-searchString="@searchString"
                                       asp-route-page="@(currentPage - 1)">

                                        Previous

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Previous
                                    </span>
                                }

                            </li>

                            <!-- CURRENT PAGE -->

                            <li class="page-item active">

                                <span class="page-link">
                                    @currentPage
                                </span>

                            </li>

                            <!-- NEXT -->

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">

                                @if (currentPage < totalPages)
                                {
                                    <a class="page-link"
                                       asp-action="FTDList"
                                       asp-route-searchString="@searchString"
                                       asp-route-page="@(currentPage + 1)">

                                        Next

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Next
                                    </span>
                                }

                            </li>

                        </ul>

                    </nav>
                }

            </div>

        }

    </div>

</div>

<!-- CREATE PAGE LOADER -->

<div id="createPageLoader"
     style="display: none;
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,0.75);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            flex-direction: column;">

    <div class="spinner-border text-primary"
         role="status"
         style="width: 3rem; height: 3rem;">

        <span class="visually-hidden">Loading...</span>

    </div>

    <div class="mt-3 fw-semibold" style="color: #555;">
        Please wait while data is loading...
    </div>

</div>


<script>
    function showCreateLoader(button) {

        const loader = document.getElementById('createPageLoader');

        if (!loader) {
            return;
        }

        // Show loader immediately
        loader.style.display = 'flex';

        // Prevent multiple clicks
        button.style.pointerEvents = 'none';
        button.style.opacity = '0.7';

        // Update button text
        button.innerHTML =
            '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Opening...';
    }
</script>

