                                            readonly />

                                    </td>


                                    <!-- FIN DIA -->

                                    <td>

                                        <input
                                            type="text"

                                            name="TblFtdFabric[${index}].FinDia"

                                            value=""

                                            class="form-control
                                                   readonly-field"

                                            readonly />

                                    </td>


                                    <!-- FIN DIA TYPE -->

                                    <td>

                                        <input
                                            type="text"

                                            name="TblFtdFabric[${index}].FinDiaType"

                                            value=""

                                            class="form-control
                                                   fabric-dia-type
                                                   readonly-field"

                                            readonly />

                                    </td>


                                    <!-- FIN GSM -->

                                    <td>

                                        <input
