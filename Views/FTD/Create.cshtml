                                        readonly />
                                </td>
                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdKnit[${index}].Construction"
                                        value="${escapeHtml(item.construction)}"
                                        class="form-control knit-construction readonly-field"
                                        readonly />
                                </td>
