                            <td colspan="3"
                                class="ftd-empty">

                                No Dyeing Recipe details available
                                for selected Batch.

                            </td>

                        </tr>

                    `);

                    return;
                }


                // =============================================
                // ADD RECIPE ROWS
                // =============================================

                recipeData.forEach(function (item, index) {

                    let row = `

                        <tr class="dyeing-recipe-row">

                            <!-- NUMBER -->

                            <td class="text-center row-number">

                                ${index + 1}

                            </td>


                            <!-- RECIPE DETAILS -->

                            <td>

                                <input
                                    type="text"

                                    name="TblFtdDyeingRecipe[${index}].RecipeDetails"

                                    value="${escapeHtml(
                                        item.recipeDetails
                                    )}"

                                    class="form-control
                                           readonly-field"

                                    readonly />

                            </td>


                            <!-- RATIO -->

                            <td>

                                <input
                                    type="number"

                                    name="TblFtdDyeingRecipe[${index}].Ratio"

                                    value="${escapeHtml(
                                        item.ratio
                                    )}"

                                    class="form-control"

                                    step="0.01"

                                    readonly />

                            </td>

                        </tr>

                    `;


                    $("#dyeingRecipeTableBody")
                        .append(row);

                });


                updateDyeingRecipeRowNumbers();

            },


            // =================================================
            // ERROR
            // =================================================

            error: function (xhr) {

                console.error(
                    "Dyeing Recipe AJAX Error:",
                    xhr
                );


                clearDyeingRecipeTable();


                let message =
                    "Unable to load Dyeing Recipe details.";


                if (
                    xhr.responseJSON &&
                    xhr.responseJSON.message
                ) {

                    message =
                        xhr.responseJSON.message;

                }


                alert(message);

            }

        });

    }


        // =========================================================
        // CONTROL / BATCH CHANGE
        // =========================================================

        $("#Control").on(
            "change",
            function () {

                let selectedValue =
                    $(this).val();


                console.log(
                    "Selected Value:",
                    selectedValue
                );


                // =================================================
                // NOTHING SELECTED
                // =================================================

                    if (!selectedValue) {

                    clearMasterFields();

                    clearFabricTable();

                    clearYarnTable();

                    clearKnitTable();

                    clearDyeingBasicTable();

                    clearDyeingRecipeTable();

                    return;
                    }



                // =================================================
                // SPLIT INTERNAL REF + BATCH
                // =================================================

                let parts =
                    selectedValue.split("|");


                let internalRef =
                    parts[0]
                        ? parts[0].trim()
                        : "";


                let batchNo =
                    parts[1]
                        ? parts[1].trim()
                        : "";


                console.log(
                    "Internal Ref:",
                    internalRef
                );


                console.log(
                    "Batch No:",
                    batchNo
                );


                // =================================================
                // VALIDATION
                // =================================================

                if (!internalRef || !batchNo) {

                    alert(
                        "Invalid Control / Batch selection."
                    );

                    clearMasterFields();

                    clearFabricTable();

                    clearYarnTable();
                    clearFabricTable();
                    return;

                }


                // =================================================
                // CLEAR OLD DATA
                // =================================================

                clearMasterFields();

                clearFabricTable();

                clearYarnTable();

                clearFabricTable();

                // =================================================
                // DISABLE CONTROL DURING LOAD
                // =================================================

                $("#Control")
                    .prop("disabled", true);


                // =================================================
                // LOAD MASTER DATA
                // =================================================

                $.ajax({

                    url:
                        '@Url.Action("GetControlDetails", "FTD")',

                    type: "GET",

                    data: {

                        internalRef:
                            batchNo,

                        batchNo:
                            batchNo

                    },


                    // =================================================
                    // SUCCESS
                    // =================================================

                    success: function (response) {

                        console.log(
                            "Master Response:",
                            response
                        );


                        if (
                            !response ||
                            !response.success ||
                            !response.data
                        ) {

                            alert(
                                response?.message ||
                                "No master data found."
                            );

                            return;

                        }


                        let data =
                            response.data;


                        // =================================================
                        // MASTER DATA
                        // =================================================


                        // COMPANY

                        $("#TblFtdMaster_Company")
                            .val(
                                data.companyName || ""
                            );


                        // BATCH NO

                        $("#TblFtdMaster_BatchNo")
                            .val(
                                data.batchNo || batchNo
                            );


                        // INTERNAL REF

                        $("#TblFtdMaster_InternalRef")
                            .val(
                                data.internalRef ||
                                batchNo
                            );


                        // SYS REQ

                        $("#TblFtdMaster_SysReq")
                            .val(
                                data.sysReq || ""
                            );


                        // BUYER

                        $("#TblFtdMaster_Buyer")
                            .val(
                                data.buyerName || ""
                            );


                        // STYLE REF

                        $("#TblFtdMaster_StyleRef")
                            .val(
                                data.styleRefNo || ""
                            );




                        // =================================================
                        // LOAD FABRIC AGAINST SELECTED BATCH
                        // =================================================

                        loadFabricDetails(
                            batchNo
                        );


                        // =================================================
                        // LOAD YARN AGAINST SELECTED BATCH
                        // =================================================

                        loadYarnDetails(
                            batchNo
                        );

                        // LOAD KNIT DETAILS AGAINST SELECTED BATCH
                        // =================================================

                        loadKnitDetails(
                            batchNo
                        );

                        // LOAD DYEING BASIC
                        // =================================================
                        loadDyeingBasicData(
                        batchNo
                        );
                        // LOAD DYEING RECIPE
                        // =================================================
                       loadDyeingRecipeData(
                       batchNo
                       );

                    },


                    // =================================================
                    // ERROR
                    // =================================================

                    error: function (xhr) {

                        console.error(
                            "Master AJAX Error:",
                            xhr
                        );


                        clearMasterFields();

                        clearFabricTable();

                        clearYarnTable();

                        clearFabricTable();


                        let message =
                            "Unable to load Control details.";


                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            message =
                                xhr.responseJSON.message;

                        }


                        alert(message);

                    },


                    // =================================================
                    // COMPLETE
                    // =================================================

                    complete: function () {

                        $("#Control")
                            .prop("disabled", false);

                    }

                });

            });


        // =========================================================
        // SELECT2 CLEAR
        // =========================================================

    $("#Control").on(
        "select2:clear",
        function () {

            clearMasterFields();

            clearFabricTable();

            clearYarnTable();

            clearKnitTable();

            clearDyeingBasicTable();

            clearDyeingRecipeTable();

        }
    );



        // =========================================================
        // REMOVE FABRIC ROW
        // =========================================================

        $(document).on(
            "click",
            ".btn-remove-fabric",
            function () {

                $(this)
                    .closest(".fabric-row")
                    .remove();

                updateFabricRowNumbers();

            }
        );


        // =========================================================
        // REMOVE YARN ROW
        // =========================================================

        $(document).on(
            "click",
            ".btn-remove-yarn",
            function () {

                $(this)
                    .closest(".yarn-row")
                    .remove();

                updateYarnRowNumbers();

            }
        );


        // =========================================================
        // INITIAL ROW NUMBERS
        // =========================================================

        updateFabricRowNumbers();
        updateYarnRowNumbers();
        updateKnitRowNumbers();
        updateDyeingBasicRowNumbers();
        updateDyeingRecipeRowNumbers();


    });

</script>

