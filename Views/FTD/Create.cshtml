        // =========================================================
        // CONTROL / BATCH CHANGE
        // =========================================================


    // =========================================================
    // CONTROL / BATCH CHANGE
    // =========================================================

    $("#Control").on("change", function () {

        let selectedValue = $(this).val();

        console.log("Selected Control Value:", selectedValue);

        // =====================================================
        // NOTHING SELECTED
        // =====================================================

        if (!selectedValue) {

            clearMasterFields();
            clearFabricTable();
            clearYarnTable();
            clearKnitTable();
            clearDyeingBasicTable();
            clearDyeingRecipeTable();

            return;
        }

        // =====================================================
        // SPLIT INTERNAL REF + BATCH
        // =====================================================

        let parts = selectedValue.split("|");

        let internalRef = parts[0] ? parts[0].trim() : "";
        let batchNo = parts[1] ? parts[1].trim() : "";

        console.log("Internal Ref:", internalRef);
        console.log("Batch No:", batchNo);

        // =====================================================
        // VALIDATION
        // =====================================================

        if (!internalRef || !batchNo) {

            alert("Invalid Control / Batch selection.");

            clearMasterFields();
            clearFabricTable();
            clearYarnTable();
            clearKnitTable();
            clearDyeingBasicTable();
            clearDyeingRecipeTable();

            return;
        }

        // =====================================================
        // CLEAR OLD DATA
        // =====================================================

        clearMasterFields();
        clearFabricTable();
        clearYarnTable();
        clearKnitTable();
        clearDyeingBasicTable();
        clearDyeingRecipeTable();

        $("#TblFtdMaster_FtdNo").val("");

        // =====================================================
        // DISABLE CONTROL DURING LOAD
        // =====================================================

        $("#Control").prop("disabled", true);

        // =====================================================
        // LOAD MASTER DATA
        // =====================================================

        $.ajax({

            url: '@Url.Action("GetControlDetails", "FTD")',

            type: "GET",

            dataType: "json",

            data: {

                // IMPORTANT:
                // Send actual Internal Ref, NOT Batch No

                internalRef: batchNo
            },

            success: function (response) {

                console.log("Master Response:", response);

                if (
                    !response ||
                    !response.success ||
                    !response.data
                ) {

                    alert(
                        response?.message ||
                        "No master data found."
                    );

                    return;
                }

                let data = response.data;

                // =================================================
                // MASTER DATA AUTO FILL
                // =================================================

                $("#TblFtdMaster_Company")
                    .val(data.companyName || "");
                    $("#TblFtdMaster_WCompany")
                    .val(data.workingCompanyName || "");

                $("#TblFtdMaster_BatchNo")
                    .val(data.batchNo || batchNo);

                $("#TblFtdMaster_InternalRef")
                    .val(data.internalRef || internalRef);

                $("#TblFtdMaster_SysReq")
                    .val(data.sysReq || "");

                $("#TblFtdMaster_Buyer")
                    .val(data.buyerName || "");

                $("#TblFtdMaster_StyleRef")
                    .val(data.styleRefNo || "");

                $("#TblFtdMaster_Fso")
                    .val(data.fso || "");


                // =================================================
                // GENERATE COMPANY SHORT NAME
                // =================================================

                let companyCode = data.companyShortName || "";

                if (!companyCode) {

                    alert("Company Name not found.");

                    return;
                }


                // =================================================
                // GENERATE FTD PREFIX
                // =================================================

                let year = new Date()
                    .getFullYear()
                    .toString()
                    .slice(-2);

                let prefix = `${companyCode}-FTD-${year}-`;


                // =================================================
                // GENERATE FTD NUMBER
                // =================================================

                $.ajax({

                    url: '@Url.Action("GetNextFtdNumber", "FTD")',

                    type: "GET",

                    dataType: "json",

                    data: {
                        prefix: prefix
                    },

                    success: function (result) {

                        console.log("FTD Number Response:", result);

                        if (result && result.ftdNo) {

                            $("#TblFtdMaster_FtdNo")
                                .val(result.ftdNo);

                            console.log(
                                "Generated FTD Number:",
                                result.ftdNo
                            );

                        } else {

                            alert("FTD Number generation failed.");

                        }
                    },

                    error: function (xhr) {

                        console.error(
                            "FTD Number AJAX Error:",
                            xhr.responseText
                        );

                        alert("Failed to generate FTD Number.");

                    }

                });


                // =================================================
                // LOAD FABRIC
                // =================================================

                loadFabricDetails(batchNo);


                // =================================================
                // LOAD YARN
                // =================================================

                loadYarnDetails(batchNo);


                // =================================================
                // LOAD KNIT
                // =================================================

                loadKnitDetails(batchNo);


                // =================================================
                // LOAD DYEING BASIC
                // =================================================

                loadDyeingBasicData(batchNo);


                // =================================================
                // LOAD DYEING RECIPE
                // =================================================

                loadDyeingRecipeData(batchNo);

            },

            error: function (xhr) {

                console.error(
                    "Master AJAX Error:",
                    xhr.responseText
                );

                clearMasterFields();
                clearFabricTable();
                clearYarnTable();
                clearKnitTable();
                clearDyeingBasicTable();
                clearDyeingRecipeTable();

                $("#TblFtdMaster_FtdNo").val("");

                let message = "Unable to load Control details.";

                if (xhr.responseJSON?.message) {
                    message = xhr.responseJSON.message;
                }

                alert(message);

            },

            complete: function () {

                $("#Control").prop("disabled", false);

            }

        });

    });



        // =========================================================
        // LAB DIP CHANGE
        // =========================================================


    // =========================================================
    // LAB DIP CHANGE
    // ONE LAB DIP -> MULTIPLE RECIPE NAMES AND RATIOS
    // =========================================================

    let labDipRequest = null;

    $("#LabDipNo").on("change", function () {

        const labDipNo = $(this).val();

        console.log("Selected Lab Dip No:", labDipNo);

        // =====================================================
        // CLEAR PREVIOUS DATA
        // =====================================================

        $("#LabProductName").val("");

        $("#labDipRecipeTableBody").empty();

        if (!labDipNo) {

            $("#labDipRecipeTableBody").html(`
                <tr id="labDipRecipeEmptyRow">
                    <td colspan="3" class="ftd-empty text-center">
                        Please select a Lab Dip No. to view recipe details.
                    </td>
                </tr>
            `);

            if (labDipRequest) {
                labDipRequest.abort();
                labDipRequest = null;
            }

            return;
        }

        // =====================================================
        // LOADING
        // =====================================================

        $("#labDipRecipeTableBody").html(`
            <tr>
                <td colspan="3" class="ftd-empty text-center">
                    Loading Lab Dip recipe details...
                </td>
            </tr>
        `);

        // Cancel previous request if still running
        if (labDipRequest) {
            labDipRequest.abort();
        }

        // =====================================================
        // LOAD LAB DIP RECIPE DETAILS
        // =====================================================

        labDipRequest = $.ajax({

            url: '@Url.Action("GetLabDipDetails", "FTD")',

            type: "GET",

            dataType: "json",

            data: {
                labDipNo: labDipNo
            },

            success: function (response) {

                console.log("Lab Dip Details Response:", response);

                if (!response || !response.success) {

                    $("#LabProductName").val("");

                    $("#labDipRecipeTableBody").html(`
                        <tr>
                            <td colspan="3" class="ftd-empty text-center">
                                ${escapeHtml(
                                    response?.message ||
                                    "No Lab Dip details found."
                                )}
                            </td>
                        </tr>
                    `);

                    return;
                }

                // Support either an array response or an object
                // containing a details array.
                const result = response.data;

                let details = [];
                let labProductName = "";

                if (Array.isArray(result)) {

                    details = result;

                    labProductName =
                        result.length > 0
                            ? (result[0].labProductName || "")
                            : "";

                } else if (result && typeof result === "object") {

                    details = Array.isArray(result.details)
                        ? result.details
                        : [];

                    labProductName = result.labProductName || "";
                }

                $("#LabProductName").val(labProductName);

                $("#labDipRecipeTableBody").empty();

                if (details.length === 0) {

                    $("#labDipRecipeTableBody").html(`
                        <tr id="labDipRecipeEmptyRow">
                            <td colspan="3" class="ftd-empty text-center">
                                No Lab Dip recipe details available.
                            </td>
                        </tr>
                    `);

                    return;
                }

                // =================================================
                // APPEND ALL RECIPE NAMES AND RATIOS
                // =================================================

                details.forEach(function (item, index) {

                    const row = $("<tr>", {
                        class: "lab-dip-recipe-row"
                    });

                    $("<td>", {
                        class: "text-center row-number",
                        text: index + 1
                    }).appendTo(row);

                    const recipeName =
                        item.recipeDetails ??
                        item.labProductName ??
                        item.productName ??
                        "";

                    const ratio =
                        item.ratio ??
                        item.labRatio ??
                        "";

                    const nameInput = $("<input>", {
                        type: "text",
                        class: "form-control readonly-field",
                        readonly: true,
                        value: recipeName
                    }).attr(
                        "name",
                        `TblLabDetailsList[${index}].RecipeDetails`
                    );

                    $("<td>")
                        .append(nameInput)
                        .appendTo(row);

                    const ratioInput = $("<input>", {
                        type: "number",
                        class: "form-control",
                        step: "0.01",
                        readonly: true,
                        value: ratio
                    }).attr(
                        "name",
                        `TblLabDetailsList[${index}].Ratio`
                    );

                    $("<td>")
                        .append(ratioInput)
                        .appendTo(row);

                    $("#labDipRecipeTableBody").append(row);
                });

            },

            error: function (xhr, status) {

                if (status === "abort") {
                    return;
                }

                console.error("Lab Dip Details AJAX Error:", xhr);

                $("#LabProductName").val("");

                $("#labDipRecipeTableBody").html(`
                    <tr>
                        <td colspan="3" class="ftd-empty text-center">
                            Unable to load Lab Dip recipe details.
                        </td>
                    </tr>
                `);
            },

            complete: function () {
                labDipRequest = null;
            }
        });

    });



        // =========================================================
        // SELECT2 CLEAR
        // =========================================================

        $("#Control").on(
            "select2:clear",
            function () {

                clearMasterFields();

                clearFabricTable();

                clearYarnTable();

                clearKnitTable();

                clearDyeingBasicTable();

                clearDyeingRecipeTable();
            }
        );


        // =========================================================
        // REMOVE FABRIC ROW
        // =========================================================

        $(document).on(
            "click",
            ".btn-remove-fabric",
            function () {

                $(this)
                    .closest(".fabric-row")
                    .remove();

                updateFabricRowNumbers();
            }
        );


        // =========================================================
        // REMOVE YARN ROW
        // =========================================================

        $(document).on(
            "click",
            ".btn-remove-yarn",
            function () {

                $(this)
                    .closest(".yarn-row")
                    .remove();

                updateYarnRowNumbers();
            }
        );


        // =========================================================
        // INITIAL ROW NUMBERS
        // =========================================================

        updateFabricRowNumbers();

        updateYarnRowNumbers();

        updateKnitRowNumbers();

        updateDyeingBasicRowNumbers();

        updateDyeingRecipeRowNumbers();


        // =========================================================
        // AUTO LOAD LAB DIP LIST ON PAGE LOAD
        // =========================================================

        loadLabDipList();


    });

</script>
@* Lab Test Result *@
<script>

    // 1. GROUP CHANGE
    $("#Ltgid").change(function () {

        var lTgid = $(this).val();

        resetTestName();
        resetMethod();
        resetResults();

        if (!lTgid) return;

        $.ajax({
            url: '@Url.Action("GetTestNamesByGroup", "LabTestResult")',
            type: 'GET',
            data: { lTgid: lTgid },

            success: function (data) {

                $.each(data, function (i, item) {

                    $("#Ltnid").append(
                        $("<option>", {
                            value: item.ltnid,
                            text: item.testName
                        })
                    );

                });

                $("#Ltnid").prop("disabled", false);
            },

            error: function () {
                alert("Failed to load Test Names.");
            }
        });

    });


    // 2. TEST NAME CHANGE
    $("#Ltnid").change(function () {

        var ltnid = $(this).val();

        resetMethod();
        resetResults();

        if (!ltnid) return;

        $.ajax({
            url: '@Url.Action("GetMethodsByTestName", "LabTestResult")',
            type: 'GET',
            data: { ltnid: ltnid },

            success: function (data) {

                $.each(data, function (i, item) {

                    $("#Ltmid").append(
                        $("<option>", {
                            value: item.methodId,
                            text: item.methodName
                        })
                    );

                });

                $("#Ltmid").prop("disabled", false);
            },

            error: function () {
                alert("Failed to load Methods.");
            }
        });

    });


    // 3. METHOD CHANGE - LOAD PARAMETERS
    $("#Ltmid").change(function () {

        var ltnid = $("#Ltnid").val();
        var ltmid = $(this).val();

        resetResults();

        if (!ltnid || !ltmid) return;

        $.ajax({
            url: '@Url.Action("GetParameters", "LabTestResult")',
            type: 'GET',
            data: {
                ltnid: ltnid,
                ltmid: ltmid
            },

            success: function (data) {

                if (!data || data.length === 0) {
                    alert("No Parameters found for this Method.");
                    return;
                }

                // GROUP PARAMETERS USING DATABASE ParameterGroup
                var groups = {};

                $.each(data, function (index, item) {

                    var groupName =
                        (item.parameterGroup || "General").trim();

                    item.parameterName =
                        (item.parameterName || "").trim();

                    if (!groups[groupName]) {
                        groups[groupName] = [];
                    }

                    groups[groupName].push(item);

                });

                var index = 0;
                var serial = 1;

                // GENERATE TABLE ROWS
                $.each(groups, function (groupName, items) {

                    $.each(items, function (i, item) {

                        var row = $("<tr>");

                        // GROUP NAME WITH ROWSPAN
                        if (i === 0) {

                            row.append(
                                $("<td>", {
                                    rowspan: items.length,
                                    class: "fw-bold align-middle text-center bg-light"
                                }).text(serial++)
                            );

                            row.append(
                                $("<td>", {
                                    rowspan: items.length,
                                    class: "fw-bold align-middle bg-light"
                                }).text(groupName)
                            );

                        }

                        // PARAMETER NAME
                        row.append(
                            $("<td>").text(item.parameterName)
                        );

                        // UNIT
                        row.append(
                            $("<td>").text(item.unit || "-")
                        );

                        // NORMAL RANGE
                        row.append(
                            $("<td>").text(item.normalRange || "-")
                        );

                        // HIDDEN PARAMETER ID
                        var hidden = $("<input>", {
                            type: "hidden",
                            name: "Results[" + index + "].ParameterId",
                            value: item.parameterId
                        });

                        // RESULT INPUT
                        var input = $("<input>", {
                            type: "text",
                            name: "Results[" + index + "].ResultValue",
                            class: "form-control",
                            placeholder: ""
                        });

                        row.append(
                            $("<td>").append(hidden, input)
                        );

                        $("#parameterBody").append(row);

                        index++;

                    });

                });

                $("#resultSection").show();

            },

            error: function () {
                alert("Failed to load Parameters.");
            }
        });

    });


    // RESET FUNCTIONS

    function resetTestName() {

        $("#Ltnid")
            .html('<option value="">-- Select Test Name --</option>')
            .prop("disabled", true);

    }

    function resetMethod() {

        $("#Ltmid")
            .html('<option value="">-- Select Method --</option>')
            .prop("disabled", true);

    }

    function resetResults() {

        $("#parameterBody").empty();
        $("#resultSection").hide();

    }

</script>
