                                    <!-- REQ DIA -->

                                    <td>

                                        <input
                                            type="text"

                                            name="TblFtdFabric[${index}].ReqDia"

                                            value="${escapeHtml(
                                                item.dia
                                            )}"

                                            class="form-control
                                                   readonly-field"

                                            readonly />

                                    </td>


                                    <!-- DIA TYPE -->

                                    <td>

                                        <input
