@model FabricDevelopmentHub.ViewModels.FTDViewModel

@{
    ViewData["Title"] = "Create FTD";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/css/ftd.css" rel="stylesheet" />



<div class="ftd-page">

    <div class="card ftd-card">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="card-header bg-fabric text-white text-center ftd-header">

            <h5 class="mb-0">
                Fabric Technical Data
            </h5>

        </div>


        <!-- =====================================================
             BODY
             ===================================================== -->

        <div class="ftd-body">

            <form asp-action="Create"
                  method="post"
                  id="ftdForm">

                <!-- VALIDATION -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- =================================================
                     MASTER INFORMATION
                     ================================================= -->

                <div class="ftd-section mt-0">

                    <div class="ftd-section-header">

                        <h6 class="ftd-section-title">
                            Master Information
                        </h6>

                    </div>

                    <hr class="ftd-section-line" />


                    <div class="row g-3">


                        <!-- FTD NO -->

                        <div class="col-lg-2 col-md-4 col-sm-6">

                            <label asp-for="TblFtdMaster.FtdNo"
                                   class="form-label">

                                FTD No.
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="TblFtdMaster.FtdNo"
                                   class="form-control readonly-field"
                                   readonly />

                            <span asp-validation-for="TblFtdMaster.FtdNo"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CONTROL -->

                        <div class="col-lg-3 col-md-4 col-sm-6">

                            <label asp-for="TblFtdMaster.Control"
                                   class="form-label">

                                Control / Batch
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="TblFtdMaster.Control"
                                    asp-items="ViewBag.ControlList"
                                    class="form-select"
                                    id="Control">

                                <option value="">
                                    -- Search Control / Batch --
                                </option>

                            </select>

                            <span asp-validation-for="TblFtdMaster.Control"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- COMPANY -->

                        <div class="col-lg-2 col-md-4 col-sm-6">

                            <label asp-for="TblFtdMaster.Company"
                                   class="form-label">

                                LC Company
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="TblFtdMaster.Company"
                                   id="TblFtdMaster_Company"
                                   class="form-control readonly-field"
                                   readonly />

                            <span asp-validation-for="TblFtdMaster.Company"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- INTERNAL REF -->

                        <div class="col-lg-2 col-md-4 col-sm-6">

                            <label class="form-label">

                                Control No.
                                <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   id="TblFtdMaster_InternalRef"
                                   class="form-control readonly-field"
                                   readonly />

                        </div>


                        <!-- BATCH NO -->

                        <div class="col-lg-2 col-md-4 col-sm-6">

                            <label asp-for="TblFtdMaster.BatchNo"
                                   class="form-label">

                                Batch No.
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="TblFtdMaster.BatchNo"
                                   id="TblFtdMaster_BatchNo"
                                   class="form-control readonly-field"
                                   readonly />

                            <span asp-validation-for="TblFtdMaster.BatchNo"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SYS REQ -->

                        <div class="col-lg-1 col-md-4 col-sm-6">

                            <label asp-for="TblFtdMaster.SysReq"
                                   class="form-label">

                                Sys. Req.
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="TblFtdMaster.SysReq"
                                   id="TblFtdMaster_SysReq"
                                   type="text"
                                   class="form-control readonly-field"
                                   readonly />

                            <span asp-validation-for="TblFtdMaster.SysReq"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- BUYER -->

                        <div class="col-lg-2 col-md-4 col-sm-6">

                            <label asp-for="TblFtdMaster.Buyer"
                                   class="form-label">

                                Buyer
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="TblFtdMaster.Buyer"
                                   id="TblFtdMaster_Buyer"
                                   class="form-control readonly-field"
                                   readonly />

                            <span asp-validation-for="TblFtdMaster.Buyer"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- STYLE REF -->

                        <div class="col-lg-5 col-md-5 col-sm-6">

                            <label asp-for="TblFtdMaster.StyleRef"
                                   class="form-label">

                                Style Ref.
                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="TblFtdMaster.StyleRef"
                                   id="TblFtdMaster_StyleRef"
                                   class="form-control readonly-field"
                                   readonly />

                            <span asp-validation-for="TblFtdMaster.StyleRef"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FABRIC DETAILS
                     ================================================= -->

                <div class="ftd-section">

                    <div class="ftd-section-header">

                        <h6 class="ftd-section-title">
                            Fabric Details
                        </h6>

                    </div>

                    <hr class="ftd-section-line" />


                    <div class="ftd-table-wrapper">

                        <table class="table table-bordered ftd-table"
                               id="fabricTable">

                            <thead>

                                <tr>

                                    <th style="width:50px;">#</th>

                                    <th>Color</th>

                                    <th>Color Type</th>

                                    <th>Fabrication</th>

                                    <th>Req. Dia</th>

                                    <th>Dia Type</th>

                                    <th>Req. GSM</th>

                                    <th>Fin. Dia</th>

                                    <th>Fin. Dia Type</th>

                                    <th>Fin. GSM</th>

                                    @* <th style="width:70px;">Action</th> *@

                                </tr>

                            </thead>


                            <tbody id="fabricTableBody">

                                @if (Model.TblFtdFabric != null &&
                                                                Model.TblFtdFabric.Count > 0)
                                {
                                    for (int i = 0;
                                    i < Model.TblFtdFabric.Count;
                                    i++)
                                    {
                                        <tr class="fabric-row">

                                            <td class="text-center row-number">
                                                @(i + 1)
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].Color"
                                                       class="form-control fabric-color readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].ColorType"
                                                       class="form-control fabric-color-type readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].Fabrication"
                                                       class="form-control fabrication readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].ReqDia"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].DiaType"
                                                       class="form-control fabric-dia-type readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].ReqGsm"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].FinDia"
                                                       class="form-control readonly-field"/>
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].FinDiaType"
                                                       class="form-control fabric-dia-type readonly-field"/>
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdFabric[i].FinGsm"
                                                       class="form-control readonly-field"/>
                                            </td>

@*                                             <td class="text-center">
                                                <button type="button"class="btn btn-outline-danger btn-sm btn-remove-row btn-remove-fabric">
                                                    ×
                                                </button>
                                            </td> *@

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="fabricEmptyRow">

                                        <td colspan="11"
                                            class="ftd-empty">

                                            No fabric details available.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     YARN DETAILS
                     ================================================= -->

                <div class="ftd-section">

                    <div class="ftd-section-header">

                        <h6 class="ftd-section-title">
                            Yarn Details
                        </h6>

                    </div>

                    <hr class="ftd-section-line" />


                    <div class="ftd-table-wrapper">

                        <table class="table table-bordered ftd-table"
                               id="yarnTable">

                            <thead>

                                <tr>

                                    <th style="width:50px;">#</th>

                                    <th>Count</th>

                                    <th>Lot No.</th>

                                    <th>Brand</th>

                                    @* <th>TPI</th>

                                    <th>Sus. Std.</th> *@

                                    <th>Remarks</th>

                                    @* <th style="width:70px;">Action</th> *@

                                </tr>

                            </thead>


                            <tbody id="yarnTableBody">

                                @if (Model.TblFtdYarn != null &&
                                                                Model.TblFtdYarn.Count > 0)
                                {
                                    for (int i = 0;
                                    i < Model.TblFtdYarn.Count;
                                    i++)
                                    {
                                        <tr class="yarn-row">

                                            <td class="text-center row-number">
                                                @(i + 1)
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdYarn[i].Count"
                                                       class="form-control yarn-count readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdYarn[i].LotNo"
                                                       class="form-control yarn-lot readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdYarn[i].Brand"
                                                       class="form-control yarn-brand readonly-field"
                                                       readonly />
                                            </td>

                                            @* <td>
                                                <input asp-for="TblFtdYarn[i].Tpi"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdYarn[i].Std"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td> *@

                                            <td>
                                                <input asp-for="TblFtdYarn[i].Remarks"
                                                       class="form-control yarn-remarks readonly-field"
                                                       readonly />
                                            </td>

                                            @* <td class="text-center">

                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm btn-remove-row btn-remove-yarn">

                                                    ×

                                                </button>

                                            </td> *@

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="yarnEmptyRow">

                                        <td colspan="8"
                                            class="ftd-empty">

                                            No yarn details available.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- =================================================
                <!-- =================================================
                     KNIT DETAILS
                     ================================================= -->

                <div class="ftd-section">

                    <div class="ftd-section-header">

                        <h6 class="ftd-section-title">
                            Knitting Details
                        </h6>

                    </div>

                    <hr class="ftd-section-line" />


                    <div class="ftd-table-wrapper">

                        <table class="table table-bordered ftd-table"
                               id="knitTable">

                            <thead>

                                <tr>

                                    <th style="width:50px;">#</th>
                                    <th>Program No.</th>
                                    <th>Source</th>
                                    <th>Knit Company</th>
                                    <th>Machine</th>
                                    <th>Dia</th>
                                    <th>Gauge</th>
                                    <th>S.L</th>
                                    <th>RPM</th>
                                    <th>Color</th>
                                    <th>Measurement</th>
                                    <th>UOM</th>
                                    <th>No. of Feeder</th>

                                </tr>

                            </thead>


                            <tbody id="knitTableBody">

                                @if (Model.TblFtdKnit != null &&
                                                                Model.TblFtdKnit.Count > 0)
                                {
                                    for (int i = 0;
                                    i < Model.TblFtdKnit.Count;
                                    i++)
                                    {
                                        <tr class="knit-row">

                                            <td class="text-center row-number">
                                                @(i + 1)
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].ProgramNo"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].Source"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].KnitCom"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].McNo"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].McDia"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].McGauge"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].Sl"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdKnit[i].Rpm" class="form-control"/>
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdKnit[i].ColorName"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdKnit[i].Measurement"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].Uom"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>


                                            <td>
                                                <input asp-for="TblFtdKnit[i].FeederNo"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="knitEmptyRow">

                                        <td colspan="12"
                                            class="ftd-empty">

                                            No Knit details available.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- =================================================
                DYEING BASIC DETAILS
                ================================================= -->

                <div class="ftd-section">

                    <div class="ftd-section-header">

                        <h6 class="ftd-section-title">
                            Dyeing Basic Data
                        </h6>

                    </div>

                    <hr class="ftd-section-line" />

                    <div class="ftd-table-wrapper">

                        <table class="table table-bordered ftd-table"
                               id="dyeingBasicTable">

                            <thead>

                                <tr>

                                    <th style="width:50px;">#</th>

                                    <th>Machine</th>

                                    <th>Inhouse Dyeing</th>

                                    <th>Shade %</th>

                                    <th>Shade</th>

                                    <th>Dyeing Part</th>

                                    <th>Non RFT</th>

                                    <th>Product Name</th>

                                    <th>Enzyme %</th>

                                </tr>

                            </thead>

                            <tbody id="dyeingBasicTableBody">

                                @if (Model.TblFtdDyeingBasic != null && Model.TblFtdDyeingBasic.Count > 0)
                                {
                                    for (int i = 0; i < Model.TblFtdDyeingBasic.Count; i++)
                                    {
                                        <tr class="dyeing-basic-row">

                                            <td class="text-center row-number">
                                                @(i + 1)
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].MachineNo"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].InhouseDyeing"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].ShadeP"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].Shade"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].DyeingPart"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].IsNonRft"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].ProductName"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                            <td>
                                                <input asp-for="TblFtdDyeingBasic[i].EnzayemPer"
                                                       class="form-control readonly-field"
                                                       readonly />
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="dyeingBasicEmptyRow">

                                        <td colspan="9"
                                            class="ftd-empty">

                                            No Dyeing Basic Data available.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- =================================================
                DYEING RECIPE DETAILS
                ================================================= -->

                <div class="ftd-section">

                    <div class="ftd-section-header">

                        <h6 class="ftd-section-title">
                            Dyeing Recipe Details
                        </h6>

                    </div>

                    <hr class="ftd-section-line" />

                    <div class="ftd-table-wrapper">

                        <table class="table table-bordered ftd-table"
                               id="dyeingRecipeTable">

                            <thead>

                                <tr>

                                    <th style="width:50px;">
                                        #
                                    </th>

                                    <th>
                                        Recipe Details
                                    </th>

                                    <th>
                                        Ratio
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="dyeingRecipeTableBody">

                                @if (Model.TblFtdDyeingRecipe != null && Model.TblFtdDyeingRecipe.Count > 0)
                                {
                                    for (int i = 0;
                                    i < Model.TblFtdDyeingRecipe.Count;
                                    i++)
                                    {
                                        <tr class="dyeing-recipe-row">

                                            <!-- NUMBER -->

                                            <td class="text-center row-number">
                                                @(i + 1)
                                            </td>


                                            <!-- RECIPE DETAILS -->

                                            <td>

                                                <input asp-for="TblFtdDyeingRecipe[i].RecipeDetails"
                                                       class="form-control readonly-field"
                                                       readonly />

                                            </td>


                                            <!-- RATIO -->

                                            <td>

                                                <input asp-for="TblFtdDyeingRecipe[i].Ratio"
                                                       class="form-control"
                                                       type="number"
                                                       step="0.01"
                                                       readonly />

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="dyeingRecipeEmptyRow">

                                        <td colspan="3"
                                            class="ftd-empty">

                                            No Dyeing Recipe details available.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>



                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="ftd-actions">

                    <a asp-action="FTDList"
                       class="btn btn-outline-secondary">

                        ← Back

                    </a>

                    <button type="submit"
                            class="btn btn-fabric px-4">

                        Save FTD

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>

    $(document).ready(function () {

        // =========================================================
        // SELECT2
        // =========================================================

        $("#Control").select2({

            placeholder: "-- Search Control / Batch --",

            allowClear: true,

            width: "100%"

        });


    // UPDATE KNIT ROW NUMBERS
    // =========================================================

    function updateKnitRowNumbers() {

        $("#knitTableBody .knit-row").each(function (index) {

            $(this)
                .find(".row-number")
                .text(index + 1);

        });
    }


        // =========================================================
        // UPDATE FABRIC ROW NUMBERS
        // =========================================================

        function updateFabricRowNumbers() {

            $("#fabricTableBody .fabric-row").each(function (index) {

                $(this)
                    .find(".row-number")
                    .text(index + 1);

            });

        }


        // =========================================================
        // UPDATE YARN ROW NUMBERS
        // =========================================================

        function updateYarnRowNumbers() {

            $("#yarnTableBody .yarn-row").each(function (index) {

                $(this)
                    .find(".row-number")
                    .text(index + 1);

            });

        }

        // UPDATE Dyeing Basic ROW NUMBERS
        // =========================================================
        function updateDyeingBasicRowNumbers() {

        $("#dyeingBasicTableBody .dyeing-basic-row").each(function (index) {

            $(this)
                .find(".row-number")
                .text(index + 1);

        });
            // =========================================================
    // UPDATE DYEING RECIPE ROW NUMBERS
    // =========================================================

    function updateDyeingRecipeRowNumbers() {

        $("#dyeingRecipeTableBody .dyeing-recipe-row")
            .each(function (index) {

                $(this)
                    .find(".row-number")
                    .text(index + 1);

            });

    }


    }

        // =========================================================
        // CLEAR MASTER DATA
        // =========================================================

        function clearMasterFields() {

            $("#TblFtdMaster_Company").val("");

            $("#TblFtdMaster_BatchNo").val("");

            $("#TblFtdMaster_SysReq").val("");

            $("#TblFtdMaster_Buyer").val("");

            $("#TblFtdMaster_StyleRef").val("");

            $("#TblFtdMaster_InternalRef").val("");

        }


    // CLEAR KNIT TABLE
    // =========================================================

    function clearKnitTable() {

        $("#knitTableBody")
            .find(".knit-row")
            .remove();

        $("#knitEmptyRow")
            .remove();

        $("#knitTableBody").append(`

            <tr id="knitEmptyRow">

                <td colspan="12"
                    class="ftd-empty">

                    No Knit details available.

                </td>

            </tr>

        `);
    }


        // =========================================================
        // CLEAR FABRIC TABLE
        // =========================================================

        function clearFabricTable() {

            $("#fabricTableBody")
                .find(".fabric-row")
                .remove();

            $("#fabricEmptyRow")
                .remove();

            $("#fabricTableBody").append(`

                <tr id="fabricEmptyRow">

                    <td colspan="11"
                        class="ftd-empty">

                        No fabric details available.

                    </td>

                </tr>

            `);

        }


        // =========================================================
        // CLEAR YARN TABLE
        // =========================================================

        function clearYarnTable() {

