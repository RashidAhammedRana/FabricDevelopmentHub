            `);

            $.ajax({

                url: '@Url.Action("GetDyeingBasicData", "FTD")',

                type: "GET",

                data: {
                    batchNo: batchNo
                },

                success: function (response) {

                    console.log(
                        "Dyeing Basic Response:",
                        response
                    );

                    if (!response || !response.success) {

                        clearDyeingBasicTable();

                        console.warn(
                            response?.message ||
                            "No Dyeing Basic Data found."
                        );

                        return;
                    }

                    let dyeingData =
                        response.data || [];

                    $("#dyeingBasicTableBody").empty();

                    if (dyeingData.length === 0) {

                        $("#dyeingBasicTableBody").append(`
                            <tr id="dyeingBasicEmptyRow">
                                <td colspan="9" class="ftd-empty">
                                    No Dyeing Basic Data available
                                    for selected Batch.
                                </td>
                            </tr>
                        `);

                        return;
                    }

                    dyeingData.forEach(function (item, index) {

                        let row = `
                            <tr class="dyeing-basic-row">

                                <td class="text-center row-number">
                                    ${index + 1}
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].MachineNo"
                                        value="${escapeHtml(item.machineNo)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].InhouseDyeing"
                                        value="${escapeHtml(item.inhouseDyeing)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].ShadeP"
                                        value="${escapeHtml(item.shadeP)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].Shade"
                                        value="${escapeHtml(item.shade)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].DyeingPart"
                                        value="${escapeHtml(item.dyeingPart)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].IsNonRft"
                                        value="${escapeHtml(item.isNonRft)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].ProductName"
                                        value="${escapeHtml(item.productName)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingBasic[${index}].EnzayemPer"
                                        value="${escapeHtml(item.enzayemPer)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                            </tr>
                        `;

                        $("#dyeingBasicTableBody")
                            .append(row);
                    });

                    updateDyeingBasicRowNumbers();
                },

                error: function (xhr) {

                    console.error(
                        "Dyeing Basic AJAX Error:",
                        xhr
                    );

                    clearDyeingBasicTable();

                    let message =
                        "Unable to load Dyeing Basic Data.";

                    if (xhr.responseJSON?.message) {
                        message = xhr.responseJSON.message;
                    }

                    alert(message);
                }
            });
        }


        // =========================================================
        // LOAD DYEING RECIPE DETAILS
        // =========================================================

        function loadDyeingRecipeData(batchNo) {

            if (!batchNo) {
                clearDyeingRecipeTable();
                return;
            }

            console.log(
                "Loading Dyeing Recipe Data for Batch:",
                batchNo
            );

            $("#dyeingRecipeTableBody").html(`
                <tr>
                    <td colspan="3" class="ftd-empty">
                        Loading dyeing recipe details...
                    </td>
                </tr>
            `);

            $.ajax({

                url: '@Url.Action("GetDyeingRecipeData", "FTD")',

                type: "GET",

                data: {
                    batchNo: batchNo
                },

                success: function (response) {

                    console.log(
                        "Dyeing Recipe Response:",
                        response
                    );

                    if (!response || !response.success) {

                        clearDyeingRecipeTable();

                        console.warn(
                            response?.message ||
                            "No Dyeing Recipe details found."
                        );

                        return;
                    }

                    let recipeData =
                        response.data || [];

                    $("#dyeingRecipeTableBody").empty();

                    if (recipeData.length === 0) {

                        $("#dyeingRecipeTableBody").append(`
                            <tr id="dyeingRecipeEmptyRow">
                                <td colspan="3" class="ftd-empty">
                                    No Dyeing Recipe details available
                                    for selected Batch.
                                </td>
                            </tr>
                        `);

                        return;
                    }

                    recipeData.forEach(function (item, index) {

                        let row = `
                            <tr class="dyeing-recipe-row">

                                <td class="text-center row-number">
                                    ${index + 1}
                                </td>

                                <td>
                                    <input
                                        type="text"
                                        name="TblFtdDyeingRecipe[${index}].RecipeDetails"
                                        value="${escapeHtml(item.recipeDetails)}"
                                        class="form-control readonly-field"
                                        readonly />
                                </td>

                                <td>
                                    <input
                                        type="number"
                                        name="TblFtdDyeingRecipe[${index}].Ratio"
                                        value="${escapeHtml(item.ratio)}"
                                        class="form-control"
                                        step="0.01"
                                        readonly />
                                </td>

                            </tr>
                        `;

                        $("#dyeingRecipeTableBody")
                            .append(row);
                    });

                    updateDyeingRecipeRowNumbers();
                },

                error: function (xhr) {

                    console.error(
                        "Dyeing Recipe AJAX Error:",
                        xhr
                    );

                    clearDyeingRecipeTable();

                    let message =
                        "Unable to load Dyeing Recipe details.";

                    if (xhr.responseJSON?.message) {
                        message = xhr.responseJSON.message;
                    }

                    alert(message);
                }
            });
        }


        // =========================================================
        // CONTROL / BATCH CHANGE
        // =========================================================

        $("#Control").on("change", function () {

            let selectedValue =
                $(this).val();

            console.log(
                "Selected Control Value:",
                selectedValue
            );

            // =====================================================
            // NOTHING SELECTED
            // =====================================================

            if (!selectedValue) {

                clearMasterFields();
                clearFabricTable();
                clearYarnTable();
                clearKnitTable();
                clearDyeingBasicTable();
                clearDyeingRecipeTable();

                return;
            }


            // =====================================================
            // SPLIT INTERNAL REF + BATCH
            // =====================================================

            let parts =
                selectedValue.split("|");

            let internalRef =
                parts[0]
                    ? parts[0].trim()
                    : "";

            let batchNo =
                parts[1]
                    ? parts[1].trim()
                    : "";


            console.log(
                "Internal Ref:",
                internalRef
            );

            console.log(
                "Batch No:",
                batchNo
            );


            // =====================================================
            // VALIDATION
            // =====================================================

            if (!internalRef || !batchNo) {

                alert(
                    "Invalid Control / Batch selection."
                );

                clearMasterFields();
                clearFabricTable();
                clearYarnTable();
                clearKnitTable();
                clearDyeingBasicTable();
                clearDyeingRecipeTable();

                return;
            }


            // =====================================================
            // CLEAR OLD DATA
            // =====================================================

            clearMasterFields();
            clearFabricTable();
            clearYarnTable();
            clearKnitTable();
            clearDyeingBasicTable();
            clearDyeingRecipeTable();


            // =====================================================
            // DISABLE CONTROL DURING LOAD
            // =====================================================

            $("#Control")
                .prop("disabled", true);


            // =====================================================
            // LOAD MASTER DATA
            // =====================================================

            $.ajax({

                url:
                    '@Url.Action("GetControlDetails", "FTD")',

                type: "GET",

                data: {

                    // IMPORTANT:
                    // Internal Ref must receive internalRef
                    // NOT batchNo

                    internalRef: batchNo,

                    batchNo: batchNo
                },

                success: function (response) {

                    console.log(
                        "Master Response:",
                        response
                    );


                    if (
                        !response ||
                        !response.success ||
                        !response.data
                    ) {

                        alert(
                            response?.message ||
                            "No master data found."
                        );

                        return;
                    }


                    let data =
                        response.data;


                    // =================================================
                    // MASTER DATA
                    // =================================================

                    $("#TblFtdMaster_Company")
                        .val(
                            data.companyName || ""
                        );


                    $("#TblFtdMaster_BatchNo")
                        .val(
                            data.batchNo || batchNo
                        );


                    $("#TblFtdMaster_InternalRef")
                        .val(
                            data.internalRef ||
                            internalRef
                        );


                    $("#TblFtdMaster_SysReq")
                        .val(
                            data.sysReq || ""
                        );


                    $("#TblFtdMaster_Buyer")
                        .val(
                            data.buyerName || ""
                        );


                    $("#TblFtdMaster_StyleRef")
                        .val(
                            data.styleRefNo || ""
                        );


                    // =================================================
                    // LOAD FABRIC
                    // =================================================

                    loadFabricDetails(batchNo);


                    // =================================================
                    // LOAD YARN
                    // =================================================

                    loadYarnDetails(batchNo);


                    // =================================================
                    // LOAD KNIT
                    // =================================================

                    loadKnitDetails(batchNo);


                    // =================================================
                    // LOAD DYEING BASIC
                    // =================================================

                    loadDyeingBasicData(batchNo);


                    // =================================================
                    // LOAD DYEING RECIPE
                    // =================================================

                    loadDyeingRecipeData(batchNo);
                },

                error: function (xhr) {

                    console.error(
                        "Master AJAX Error:",
                        xhr
                    );

                    clearMasterFields();
                    clearFabricTable();
                    clearYarnTable();
                    clearKnitTable();
                    clearDyeingBasicTable();
                    clearDyeingRecipeTable();

                    let message =
                        "Unable to load Control details.";

                    if (xhr.responseJSON?.message) {
                        message =
                            xhr.responseJSON.message;
                    }

                    alert(message);
                },

                complete: function () {

                    $("#Control")
                        .prop("disabled", false);
                }
            });

        });


        // =========================================================
        // LAB DIP CHANGE
        // =========================================================

        $("#LabDipNo").on("change", function () {

            let labDipNo =
                $(this).val();

            console.log(
                "Selected Lab Dip No:",
                labDipNo
            );


            // =====================================================
            // CLEAR PREVIOUS DATA
            // =====================================================

            $("#LabProductName")
                .val("");

            $("#LabRatio")
                .val("");


            if (!labDipNo) {
                return;
            }


            // =====================================================
            // LOADING
            // =====================================================

            $("#LabProductName")
                .val("Loading...");


            $.ajax({

                url:
                    '@Url.Action("GetLabDipDetails", "FTD")',

                type: "GET",

                data: {

                    labDipNo:
                        labDipNo
                },

                success: function (response) {

                    console.log(
                        "Lab Dip Details Response:",
                        response
                    );


                    if (
                        !response ||
                        !response.success
                    ) {

                        $("#LabProductName")
                            .val("");

                        $("#LabRatio")
                            .val("");

                        alert(
                            response?.message ||
                            "No Lab Dip details found."
                        );

                        return;
                    }


                    let data =
                        response.data || [];


                    if (data.length === 0) {

                        $("#LabProductName")
                            .val("");

                        $("#LabRatio")
                            .val("");

                        return;
                    }


                    // =================================================
                    // FIRST LAB DIP DATA
                    // =================================================

                    let item =
                        data[0];


                    $("#LabProductName")
                        .val(
                            item.labProductName || ""
                        );


                    $("#LabRatio")
                        .val(
                            item.labRatio ?? ""
                        );
                },

                error: function (xhr) {

                    console.error(
                        "Lab Dip Details AJAX Error:",
                        xhr
                    );

                    $("#LabProductName")
                        .val("");

                    $("#LabRatio")
                        .val("");

                    let message =
                        "Unable to load Lab Dip details.";

                    if (xhr.responseJSON?.message) {

                        message =
                            xhr.responseJSON.message;
                    }

                    alert(message);
                }
            });

        });


        // =========================================================
        // SELECT2 CLEAR
        // =========================================================

        $("#Control").on(
            "select2:clear",
            function () {

                clearMasterFields();

                clearFabricTable();

                clearYarnTable();

                clearKnitTable();

                clearDyeingBasicTable();

                clearDyeingRecipeTable();
            }
        );


        // =========================================================
        // REMOVE FABRIC ROW
        // =========================================================

        $(document).on(
            "click",
            ".btn-remove-fabric",
            function () {

                $(this)
                    .closest(".fabric-row")
                    .remove();

                updateFabricRowNumbers();
            }
        );


        // =========================================================
        // REMOVE YARN ROW
        // =========================================================

        $(document).on(
            "click",
            ".btn-remove-yarn",
            function () {

                $(this)
                    .closest(".yarn-row")
                    .remove();

                updateYarnRowNumbers();
            }
        );


        // =========================================================
        // INITIAL ROW NUMBERS
        // =========================================================

        updateFabricRowNumbers();

        updateYarnRowNumbers();

        updateKnitRowNumbers();

        updateDyeingBasicRowNumbers();

        updateDyeingRecipeRowNumbers();


        // =========================================================
        // AUTO LOAD LAB DIP LIST ON PAGE LOAD
        // =========================================================

        loadLabDipList();


    });

</script>
