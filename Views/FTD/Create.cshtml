    function loadLabDipList() {

        console.log("Loading Lab Dip List...");

        $("#LabDipNo").html(`
            <option value="">Loading Lab Dip No...</option>
        `);

        $.ajax({
            url: '@Url.Action("GetLabDipList", "FTD")',
            type: "GET",

            success: function (response) {

                console.log("Lab Dip List Response:", response);

                $("#LabDipNo").empty();

                $("#LabDipNo").append(`
                    <option value="">-- Select Lab Dip No. --</option>
                `);

                if (!response || !response.success || !response.data) {
                    console.warn(
                        response?.message || "No Lab Dip data found."
                    );
                    return;
                }

                response.data.forEach(function (item) {

                    $("#LabDipNo").append(
                        $("<option>", {
                            value: item.labDipNo,
                            text: item.labDipNo
                        })
                    );

                });
            },

            error: function (xhr) {

                console.error("Lab Dip List AJAX Error:", xhr);

                $("#LabDipNo").html(`
                    <option value="">-- Select Lab Dip No. --</option>
                `);

                alert(
