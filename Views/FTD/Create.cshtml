                                    <!-- COLOR TYPE -->

                                    <td>

                                        <input
                                            type="text"

                                            name="TblFtdFabric[${index}].ColorType"

                                            value="${escapeHtml(
                                                item.colorTypeId
                                            )}"

                                            class="form-control
                                                   fabric-color-type
