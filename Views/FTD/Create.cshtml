@model FabricDevelopmentHub.ViewModels.FTDViewModel

@{
    ViewData["Title"] = "Create FTD";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/css/ftd.css" rel="stylesheet" />

<style>

    /* =========================================
                                   FTD STEPPER
                                   ========================================= */

    .stepper-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        max-width: 600px;
        margin: 25px auto 35px;
        position: relative;
    }

    /* Individual Step */

    .stepper-item {
        flex: 1;
        position: relative;
        text-align: center;
        color: #9ca3af;
        z-index: 1;
    }

        /* Connecting Line */

        .stepper-item:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 20px;
            left: calc(50% + 22px);
            width: calc(100% - 44px);
            height: 3px;
            background-color: #dee2e6;
            z-index: -1;
        }

    /* Step Counter */

    .step-counter {
        width: 42px;
        height: 42px;
        margin: 0 auto 10px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #e9ecef;
        color: #6c757d;
        border: 3px solid #dee2e6;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.25s ease;
    }

    /* Step Name */

    .step-name {
        font-size: 14px;
        font-weight: 600;
        color: #6c757d;
        transition: color 0.25s ease;
    }

    /* Active Step */

    .stepper-item.active .step-counter {
        background-color: #0f8996;
        border-color: #0f8996;
        color: #ffffff;
        box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.12);
    }

    .stepper-item.active .step-name {
        color: #0f8996;
        font-weight: 700;
    }

    /* Completed Step */

    .stepper-item.completed .step-counter {
        background-color: #0f8996;
        border-color: #0f8996;
        color: #ffffff;
    }

    .stepper-item.completed .step-name {
        color: #0f8996;
    }

    /* Connector after completed step */

    .stepper-item.completed:not(:last-child)::after {
        background-color: #0f8996;
    }

    /* =========================================
                                   STEP CONTENT
                                   ========================================= */

    .step-content {
        display: none;
        animation: stepFadeIn 0.3s ease-in-out;
    }

        .step-content.active {
            display: block;
        }

    @@keyframes stepFadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================
                                   STEPPER ACTION BUTTONS
                                   ========================================= */

    .ftd-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

        .ftd-actions .btn {
            min-height: 40px;
            font-weight: 600;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

        .ftd-actions .btn-fabric {
            background-color: #0f8996;
            border-color: #0f8996;
            color: #ffffff;
        }

            .ftd-actions .btn-fabric:hover {
                background-color: #0f8996;
                border-color: #0f8996;
                color: #ffffff;
            }

        .ftd-actions .btn-outline-secondary:hover {
            transform: translateY(-1px);
        }

    /* =========================================
                                   RESPONSIVE
                                   ========================================= */

    @@media (max-width: 576px) {
        .stepper-wrapper {
            margin: 20px auto 25px;
        }

        .step-counter {
            width: 36px;
            height: 36px;
            font-size: 14px;
        }

        .stepper-item:not(:last-child)::after {
            top: 17px;
            left: calc(50% + 19px);
            width: calc(100% - 38px);
        }

        .step-name {
            font-size: 12px;
        }

        .ftd-actions {
            flex-wrap: wrap;
        }

            .ftd-actions > a {
                margin-bottom: 5px;
            }

            .ftd-actions > div {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }
    }

    #knitTable {
        width: 100%;
        min-width: 1400px;
        table-layout: fixed;
    }

        #knitTable th,
        #knitTable td {
            vertical-align: middle;
        }

        #knitTable .knit-photo {
            width: 100%;
            min-width: 0;
            font-size: 12px;
        }

        #knitTable td:last-child {
            padding: 8px;
        }

    /* =========================================
       DRD PHOTO UPLOAD DESIGN
    ========================================= */

    .drd-photo-section {
        margin-top: 22px;
        padding: 18px;
        background: #f8fafc;
        border: 1px solid #dce5ef;
        border-radius: 10px;
    }

    .drd-photo-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

        .drd-photo-header h6 {
            margin: 0;
            font-weight: 700;
            color: #243b53;
            font-size: 14px;
        }

        .drd-photo-header small {
            color: #7b8794;
            font-size: 12px;
        }

    .drd-photo-badge {
        background: #e8f1ff;
        color: #2463a6;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .drd-photo-upload-area {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        padding: 20px;
        background: #ffffff;
        border: 1.5px dashed #a9bfd5;
        border-radius: 8px;
    }

    .drd-photo-icon {
        width: 55px;
        height: 55px;
        background: #edf4ff;
        color: #3675b9;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 23px;
    }

    .drd-photo-content {
        flex: 1;
        min-width: 180px;
    }

    .drd-photo-label {
        color: #245b91;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        margin-bottom: 4px;
    }

    .drd-photo-content p {
        margin: 0;
        color: #526477;
        font-size: 12px;
    }

    .drd-photo-content small {
        color: #98a6b5;
        font-size: 11px;
    }

    .drd-photo-input {
        width: 280px;
        max-width: 100%;
    }

        .drd-photo-input input {
            font-size: 12px;
        }

    .drd-photo-filename {
        width: 100%;
        padding-top: 10px;
        border-top: 1px solid #edf0f4;
        color: #526477;
        font-size: 12px;
        overflow-wrap: anywhere;
    }
</style>

<div class="ftd-page">

    <div class="card ftd-card">

        <div class="card-header bg-fabric text-white text-center ftd-header">
            <h5 class="mb-0">Fabric Technical Datasheet</h5>
        </div>

        <div class="ftd-body">

            <form asp-action="Create" method="post" id="ftdForm" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- STEPPER HEADER -->

                <div class="stepper-wrapper mb-4">

                    <div class="stepper-item active" data-step="1">
                        <div class="step-counter">1</div>
                        @* <div class="step-name">Booking Details</div> *@
                    </div>

                    @* <div class="stepper-item" data-step="2">
                        <div class="step-counter">2</div>
                        <div class="step-name">Heatset Process</div>
                    </div> *@

                    <div class="stepper-item" data-step="2">
                        <div class="step-counter">2</div>
                        @* <div class="step-name">Finish Process Stentering</div> *@
                    </div>

                    @* <div class="stepper-item" data-step="4">
                        <div class="step-counter">4</div>
                        <div class="step-name">Singeing & Squeezing</div>
                    </div> *@

                    <div class="stepper-item" data-step="3">
                        <div class="step-counter">3</div>
                        @* <div class="step-name">Brush</div> *@
                    </div>

                    <div class="stepper-item" data-step="4">
                        <div class="step-counter">4</div>
                        @* <div class="step-name">Compacting & Other Process</div> *@
                    </div>
                    @* <div class="stepper-item" data-step="5">
                        <div class="step-counter">5</div>
                        <div class="step-name">Lab Test Result</div> 
                    </div> *@

                </div>

                <!-- ==========================================
                     STEP 1 START
                     ========================================== -->

                <div class="step-content active" id="step-1">

                    <!-- MASTER INFORMATION -->

                    <div class="ftd-section mt-0">

                        <div class="ftd-section-header">
                            <h6 class="ftd-section-title">
                                Booking Details
                            </h6>
                        </div>

                        <hr class="ftd-section-line" />

                        <div class="row g-3">

                            <div class="col-lg-2 col-md-3 col-sm-6">
                                <label asp-for="TblFtdMaster.Control"
                                       class="form-label">
                                    Control / Batch
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="TblFtdMaster.Control"
                                        asp-items="ViewBag.ControlList"
                                        class="form-select"
                                        id="Control">

                                    <option value="">
                                        -- Search Control / Batch --
                                    </option>

                                </select>

                                <span asp-validation-for="TblFtdMaster.Control"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.FtdNo"
                                       class="form-label">
                                    FTD No.
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.FtdNo"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.FtdNo"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.Company"
                                       class="form-label">
                                    LC Company
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.Company"
                                       id="TblFtdMaster_Company"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.Company"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.WorkingCompany"
                                       class="form-label">
                                    Working Company
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.WorkingCompany"
                                       id="TblFtdMaster_WCompany"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.WorkingCompany"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label class="form-label">
                                    Control No.
                                    <span class="text-danger">*</span>
                                </label>

                                <input type="text"
                                       id="TblFtdMaster_InternalRef"
                                       class="form-control readonly-field"
                                       readonly />
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.BatchNo"
                                       class="form-label">
                                    Batch No.
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.BatchNo"
                                       id="TblFtdMaster_BatchNo"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.BatchNo"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.SysReq"
                                       class="form-label">
                                    Sys. Req.
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.SysReq"
                                       id="TblFtdMaster_SysReq"
                                       type="text"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.SysReq"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.Buyer"
                                       class="form-label">
                                    Buyer
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.Buyer"
                                       id="TblFtdMaster_Buyer"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.Buyer"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <label asp-for="TblFtdMaster.StyleRef"
                                       class="form-label">
                                    Style Ref.
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.StyleRef"
                                       id="TblFtdMaster_StyleRef"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.StyleRef"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6">
                                <label asp-for="TblFtdMaster.Fso"
                                       class="form-label">
                                    FSO
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="TblFtdMaster.Fso"
                                       id="TblFtdMaster_Fso"
                                       class="form-control readonly-field"
                                       readonly />

                                <span asp-validation-for="TblFtdMaster.Fso"
                                      class="text-danger"></span>
                            </div>

                        </div>

                    </div>

                    <!-- =================================================
                    FABRIC DETAILS
                    ================================================= -->

                    <div class="ftd-section">

                        <div class="ftd-section-header">
                            <h6 class="ftd-section-title">
                                Fabric Details
                            </h6>
                        </div>

                        <hr class="ftd-section-line" />

                        <div class="ftd-table-wrapper">

                            <table class="table table-bordered ftd-table"
                                   id="fabricTable">

                                <thead>
                                    <tr>
                                        <th style="width:50px;">#</th>
                                        <th>Color</th>
                                        <th>Color Type</th>
                                        <th>Fabrication</th>
                                        <th>Req. Dia</th>
                                        <th>Dia Type</th>
                                        <th>Req. GSM</th>
                                        @* <th>Fin. Dia</th>
                                        <th>Fin. Dia Type</th>
                                        <th>Fin. GSM</th> *@
                                    </tr>
                                </thead>

                                <tbody id="fabricTableBody">

                                    @if (Model.TblFtdFabric != null &&
                                                                        Model.TblFtdFabric.Count > 0)
                                    {
                                        for (int i = 0;
                                        i < Model.TblFtdFabric.Count;
                                        i++)
                                        {
                                            <tr class="fabric-row">

                                                <td class="text-center row-number">
                                                    @(i + 1)
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].Color"
                                                           class="form-control fabric-color readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].ColorType"
                                                           class="form-control fabric-color-type readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].Fabrication"
                                                           class="form-control fabrication readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].ReqDia"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].DiaType"
                                                           class="form-control fabric-dia-type readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].ReqGsm"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                @* <td>
                                                    <input asp-for="TblFtdFabric[i].FinDia"
                                                           class="form-control readonly-field" />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].FinDiaType"
                                                           class="form-control fabric-dia-type readonly-field" />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdFabric[i].FinGsm"
                                                           class="form-control readonly-field" />
                                                </td> *@

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr id="fabricEmptyRow">
                                            <td colspan="10" class="ftd-empty">
                                                No fabric details available.
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- =================================================
                         YARN DETAILS
                         ================================================= -->

                    <div class="ftd-section">

                        <div class="ftd-section-header">
                            <h6 class="ftd-section-title">
                                Yarn Details
                            </h6>
                        </div>

                        <hr class="ftd-section-line" />

                        <div class="ftd-table-wrapper">

                            <table class="table table-bordered ftd-table"
                                   id="yarnTable">

                                <thead>
                                    <tr>
                                        <th style="width:50px;">#</th>
                                        <th>Construction</th>
                                        <th>Count</th>
                                        <th>Brand</th>
                                        <th>Lot No.</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>

                                <tbody id="yarnTableBody">

                                    @if (Model.TblFtdYarn != null &&
                                                                        Model.TblFtdYarn.Count > 0)
                                    {
                                        for (int i = 0;
                                        i < Model.TblFtdYarn.Count;
                                        i++)
                                        {
                                            <tr class="yarn-row">

                                                <td class="text-center row-number">
                                                    @(i + 1)
                                                </td>
                                                <td>
                                                    <input asp-for="TblFtdYarn[i].Construction"
                                                           class="form-control yarn-construction readonly-field"
                                                           readonly />
                                                </td>
                                                <td>
                                                    <input asp-for="TblFtdYarn[i].Count"
                                                           class="form-control yarn-count readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdYarn[i].LotNo"
                                                           class="form-control yarn-lot readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdYarn[i].Brand"
                                                           class="form-control yarn-brand readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdYarn[i].Remarks"
                                                           class="form-control yarn-remarks readonly-field"
                                                           readonly />
                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr id="yarnEmptyRow">
                                            <td colspan="5" class="ftd-empty">
                                                No yarn details available.
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <!-- =================================================
                    KNITTING DETAILS
                    ================================================= -->


                    <div class="ftd-section">

                        <div class="ftd-section-header">
                            <h6 class="ftd-section-title">
                                Knitting Details
                            </h6>
                        </div>

                        <hr class="ftd-section-line" />

                        <div class="ftd-table-wrapper">

                            <table class="table table-bordered ftd-table"
                                   id="knitTable">

                                <colgroup>
                                    <col style="width: 45px;" />
                                    <col style="width: 110px;" />
                                    <col style="width: 140px;" />
                                    <col style="width: 90px;" />
                                    <col style="width: 120px;" />
                                    <col style="width: 80px;" />
                                    <col style="width: 75px;" />
                                    <col style="width: 75px;" />
                                    <col style="width: 75px;" />
                                    <col style="width: 75px;" />
                                    <col style="width: 100px;" />
                                    <col style="width: 100px;" />
                                    <col style="width: 75px;" />
                                    <col style="width: 75px;" />
                                    <col style="width: 160px;" />
                                </colgroup>

                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Program No.</th>
                                        <th>Construction</th>
                                        <th>Source</th>
                                        <th>Knit Company</th>
                                        <th>Machine</th>
                                        <th>Dia</th>
                                        <th>Gauge</th>
                                        <th>S.L</th>
                                        <th>RPM</th>
                                        <th>Color</th>
                                        <th>Measurement</th>
                                        <th>UOM</th>
                                        <th>No. of Feeder</th>
                                        <th>Photo</th>
                                    </tr>
                                </thead>

                                <tbody id="knitTableBody">

                                    @if (Model.TblFtdKnit != null &&
                                                                        Model.TblFtdKnit.Count > 0)
                                    {
                                        for (int i = 0;
                                        i < Model.TblFtdKnit.Count;
                                        i++)
                                        {
                                            <tr class="knit-row">

                                                <td class="text-center row-number">
                                                    @(i + 1)
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].ProgramNo"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].Construction"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].Source"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].KnitCom"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].McNo"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].McDia"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].McGauge"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].Sl"
                                                           class="form-control readonly-field"
                                                           readonly />
                                                </td>

                                                <td>
                                                    <input asp-for="TblFtdKnit[i].Rpm"
                                                           class="form-control"
                                                           type="number"
                                                           step="any" />
                                                </td>

