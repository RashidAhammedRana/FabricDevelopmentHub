                                </tr>

                            `;


                            $("#fabricTableBody")
                                .append(row);

                        });


                        updateFabricRowNumbers();

                    },


                    // =================================================
                    // ERROR
                    // =================================================

                    error: function (xhr) {

                        console.error(
                            "Fabric AJAX Error:",
                            xhr
                        );


                        clearFabricTable();


                        let message =
                            "Unable to load Fabric details.";


                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            message =
                                xhr.responseJSON.message;

                        }


                        alert(message);

                    }

                });

            }


            // =========================================================
            // CONTROL / BATCH CHANGE
            // =========================================================

            $("#Control").on(
                "change",
                function () {


                    let selectedValue =
                        $(this).val();


                    console.log(
                        "Selected Value:",
                        selectedValue
                    );


                    // =================================================
                    // NOTHING SELECTED
                    // =================================================

                    if (!selectedValue) {

                        clearMasterFields();

                        clearFabricTable();

                        clearYarnTable();

                        return;

                    }


                    // =================================================
                    // SPLIT INTERNAL REF + BATCH
                    // =================================================

                    let parts =
                        selectedValue.split("|");


                    let internalRef =
                        parts[0]
                            ? parts[0].trim()
                            : "";


                    let batchNo =
                        parts[1]
                            ? parts[1].trim()
                            : "";


                    console.log(
                        "Internal Ref:",
                        internalRef
                    );


                    console.log(
                        "Batch No:",
                        batchNo
                    );


                    // =================================================
                    // VALIDATION
                    // =================================================

                    if (!internalRef || !batchNo) {

                        alert(
                            "Invalid Control / Batch selection."
                        );

                        return;

                    }


                    // =================================================
                    // CLEAR OLD DATA
                    // =================================================

                    clearMasterFields();

                    clearFabricTable();

                    clearYarnTable();


                    // =================================================
                    // DISABLE CONTROL DURING LOAD
                    // =================================================

                    $("#Control")
                        .prop("disabled", true);


                    // =================================================
                    // LOAD MASTER DATA
                    // =================================================

                    $.ajax({

                        url:
                            '@Url.Action("GetControlDetails", "FTD")',

                        type: "GET",

                        data: {

                            internalRef:
                                internalRef,

                            batchNo:
                                batchNo

                        },


                        // =================================================
                        // SUCCESS
                        // =================================================

                        success: function (response) {

                            console.log(
                                "Master Response:",
                                response
                            );


                            if (
                                !response ||
                                !response.success ||
                                !response.data
                            ) {

                                alert(
                                    response?.message ||
                                    "No master data found."
                                );

                                return;

                            }


                            let data =
                                response.data;


                            // =================================================
                            // MASTER DATA
                            // =================================================


                            // COMPANY

                            $("#TblFtdMaster_Company")
                                .val(
                                    data.companyName || ""
                                );


                            // BATCH NO

                            $("#TblFtdMaster_BatchNo")
                                .val(
                                    data.batchNo || ""
                                );

                                $("#TblFtdMaster_InternalRef")
                                .val(
                                    data.internalRef || ""
                                );


                            // SYS REQ

                            $("#TblFtdMaster_SysReq")
                                .val(
                                    data.sysReq || ""
                                );


                            // BUYER

                            $("#TblFtdMaster_Buyer")
                                .val(
                                    data.buyerName || ""
                                );


                            // STYLE REF

                            $("#TblFtdMaster_StyleRef")
                                .val(
                                    data.styleRefNo || ""
                                );


                            // =================================================
                            // LOAD FABRIC AGAINST SELECTED BATCH
                            // =================================================

                            loadFabricDetails(
                                batchNo
                            );

                        },


                        // =================================================
                        // ERROR
                        // =================================================

                        error: function (xhr) {

                            console.error(
                                "Master AJAX Error:",
                                xhr
                            );


                            clearMasterFields();

                            clearFabricTable();


                            let message =
                                "Unable to load Control details.";


                            if (
                                xhr.responseJSON &&
                                xhr.responseJSON.message
                            ) {

                                message =
                                    xhr.responseJSON.message;

                            }


                            alert(message);

                        },


                        // =================================================
                        // COMPLETE
                        // =================================================

                        complete: function () {

                            $("#Control")
                                .prop("disabled", false);

                        }

                    });

                });


            // =========================================================
            // SELECT2 CLEAR
            // =========================================================

            $("#Control").on(
                "select2:clear",
                function () {

                    clearMasterFields();

                    clearFabricTable();

                    clearYarnTable();

                }
            );


            // =========================================================
            // REMOVE FABRIC ROW
            // =========================================================

            $(document).on(
                "click",
                ".btn-remove-fabric",
                function () {

                    $(this)
                        .closest(".fabric-row")
                        .remove();

                    updateFabricRowNumbers();

                }
            );


            // =========================================================
            // REMOVE YARN ROW
            // =========================================================

            $(document).on(
                "click",
                ".btn-remove-yarn",
                function () {

                    $(this)
                        .closest(".yarn-row")
                        .remove();

                    updateYarnRowNumbers();

                }
            );


            // =========================================================
            // INITIAL ROW NUMBERS
            // =========================================================

            updateFabricRowNumbers();

            updateYarnRowNumbers();

        });

    </script>


}
