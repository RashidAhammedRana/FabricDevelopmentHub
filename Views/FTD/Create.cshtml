<script>
    document.addEventListener('DOMContentLoaded', function () {

        const form = document.getElementById('ftdForm');
        const saveBtn = document.getElementById('saveBtn');
        const loader = document.getElementById('saveLoader');
        const spinner = document.getElementById('saveBtnSpinner');
        const btnText = document.getElementById('saveBtnText');

        if (!form || !saveBtn || !loader) {
            console.error('Save loader: Form, button, or loader not found.');
            return;
        }

        form.addEventListener('submit', function (event) {

            // Prevent invalid form submission
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Prevent duplicate submission
            if (saveBtn.disabled) {
                event.preventDefault();
                return;
            }

            // Show loader
            loader.style.display = 'flex';

            if (spinner) {
                spinner.style.display = 'inline-block';
            }

            if (btnText) {
                btnText.textContent = 'Saving...';
            }

            saveBtn.disabled = true;

        });

    });

</script>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("ftdForm");

        if (!form) return;

        const steps = Array.from(
            form.querySelectorAll(".step-content")
        );

        const stepperItems = Array.from(
            form.querySelectorAll(".stepper-item")
        );

        const nextBtn = document.getElementById("nextBtn");
        const prevBtn = document.getElementById("prevBtn");
        const saveBtn = document.getElementById("saveBtn");

        const backBtn = document.getElementById("backBtn");

        let currentStep = 1;

            function showStep(stepNumber) {

        currentStep = stepNumber;

        // Show the selected step content
        steps.forEach(function (step, index) {

            const isActive = index + 1 === stepNumber;

            step.classList.toggle("active", isActive);

            // Prevent hidden step controls from receiving focus
            if (isActive) {
                step.removeAttribute("hidden");
            } else {
                step.setAttribute("hidden", "");
            }
        });

        // Update stepper indicators
        stepperItems.forEach(function (item, index) {

            const itemStep = index + 1;

            item.classList.toggle(
                "active",
                itemStep === stepNumber
            );

            item.classList.toggle(
                "completed",
                itemStep < stepNumber
            );
        });

        // Update navigation buttons
        if (prevBtn) {
            prevBtn.style.display =
                stepNumber === 1 ? "none" : "inline-block";
        }

        if (nextBtn) {
            nextBtn.style.display =
                stepNumber === steps.length ? "none" : "inline-block";
        }

        if (saveBtn) {
            saveBtn.style.display =
                stepNumber === steps.length ? "inline-block" : "none";
        }

        // Keep the Back to List link available
        if (backBtn) {
            backBtn.style.display = "inline-block";
        }

        // Scroll to the top of the page without targeting
        // the step container, avoiding unexpected header positioning.
        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }

        // Next button
        if (nextBtn) {
            nextBtn.addEventListener("click", function () {

                if (currentStep < steps.length) {
                    showStep(currentStep + 1);
                }
            });
        }

        // Previous button
        if (prevBtn) {
            prevBtn.addEventListener("click", function () {

                if (currentStep > 1) {
                    showStep(currentStep - 1);
                }
            });
        }

        // Initial state
        showStep(1);

    });

</script>
<script>

