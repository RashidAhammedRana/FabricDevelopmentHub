@model FabricDevelopmentHub.ViewModels.FTDViewModel

@{
    ViewData["Title"] = "Delete FTD";
}

<style>

    .delete-container {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .delete-card {
        width: 100%;
        max-width: 550px;
        border-radius: 10px;
        overflow: hidden;
    }

        .delete-card .card-header {
            padding: 15px;
        }

        .delete-card .card-body {
            padding: 25px;
        }

    /* CONFIRMATION CARD */

    #confirmationCard {
        display: none;
    }

</style>


<div class="container delete-container">

    <!-- ================================= -->
    <!-- FIRST DELETE CARD -->
    <!-- ================================= -->

    <div class="card shadow delete-card" id="deleteCard">

        <div class="card-header bg-danger text-white text-center">

            <h4 class="mb-0">
                @* <i class="bi bi-trash"></i> *@
                Delete Fabric Technical Data
            </h4>

        </div>

        <div class="card-body">

            <h5 class="text-center mb-4">
                Are you sure you want to delete this FTD?
            </h5>

            <hr />

            <dl class="row mb-4">

                <dt class="col-4">
                    FTD ID
                </dt>

                <dd class="col-8">
                    @Model.TblFtdMaster.Ftdid
                </dd>

                <dt class="col-4">
                    FTD No
                </dt>

                <dd class="col-8">
                    @Model.TblFtdMaster.FtdNo
                </dd>

            </dl>

            <hr />

            <div class="d-flex justify-content-center gap-3 mt-4">

                <button type="button"
                        class="btn btn-danger px-4"
                        onclick="showConfirmation()">

                    <i class="bi bi-trash"></i>
                    Delete

                </button>

                <a asp-action="FTDList"
                   class="btn btn-secondary px-4">

                    <i class="bi bi-x-circle"></i>
                    Cancel

                </a>

            </div>

        </div>

    </div>


    <!-- ================================= -->
    <!-- SECOND CONFIRMATION CARD -->
    <!-- SAME POSITION AND SAME SIZE -->
    <!-- ================================= -->

    <div class="card shadow delete-card" id="confirmationCard">

        <div class="card-header bg-danger text-white text-center">

            <h4 class="mb-0">
                <i class="bi bi-exclamation-triangle"></i>
                Confirm Deletion
            </h4>

        </div>

        <div class="card-body text-center">

            <i class="bi bi-exclamation-triangle-fill text-danger"
               style="font-size: 55px;">
            </i>

            <h5 class="mt-3">
                Are you sure?
            </h5>

            <p class="text-muted mt-2">
                Do you really want to permanently delete this FTD record?
            </p>

            <hr />

            <div class="d-flex justify-content-center gap-3 mt-4">

                <!-- NO BUTTON -->

                @* <button type="button"
                        class="btn btn-secondary px-4"
                        onclick="hideConfirmation()">

                    <i class="bi bi-x-circle"></i>
                    No

                </button> *@

                <a asp-action="FTDList"
                   class="btn btn-secondary px-4">

                    <i class="bi bi-x-circle"></i>
                    No

                </a>


                <!-- YES DELETE BUTTON -->

                <form asp-action="ConfirmDelete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.TblFtdMaster.Ftdid" />

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash"></i>
                        Yes, Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<script>

    // SHOW CONFIRMATION CARD

    function showConfirmation() {

        document.getElementById('deleteCard').style.display = 'none';

        document.getElementById('confirmationCard').style.display = 'block';

    }


    // BACK TO FIRST DELETE CARD

    // function hideConfirmation() {

    //     document.getElementById('confirmationCard').style.display = 'none';

    //     document.getElementById('deleteCard').style.display = 'block';

    // }

</script>
