                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Wash Image</span><span class="detail-value">@((Model.TblOtherProcess?.ImageW?.Length ?? 0) > 0 ? "Available" : "Not available")</span></div></div>
            </div>
        </div>

        <!-- FOOTER BUTTONS -->
        <div class="ftd-footer">

            <a asp-action="FTDList" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>
