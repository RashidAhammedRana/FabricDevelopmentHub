        <!-- SINGEING AND SQUEEZING -->
        <div class="ftd-section">
            <div class="ftd-section-header"><h6 class="ftd-section-title">Singeing &amp; Squeezing</h6></div>
            <hr class="ftd-section-line" />
            <div class="row g-2">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Burner Temperature</span><span class="detail-value">@(Model.TblSingeing?.BurnerTemp)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Flame Height</span><span class="detail-value">@(Model.TblSingeing?.FlameHeight)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Singeing Speed</span><span class="detail-value">@(Model.TblSingeing?.Speed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Singeing GSM</span><span class="detail-value">@(Model.TblSingeing?.ASingeingGsm)</span></div></div>
