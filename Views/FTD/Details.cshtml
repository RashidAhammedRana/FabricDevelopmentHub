                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Wash Remarks</span><span class="detail-value">@(Model.TblOtherProcess?.WashRemarks)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Print Type</span><span class="detail-value">@(Model.TblOtherProcess?.PrintType)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">No. of Colors (Print)</span><span class="detail-value">@(Model.TblOtherProcess?.NoOfColorP)</span></div></div>
