                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Shrinkage</span><span class="detail-value">@(Model.TblCompacting?.Shrinkage)</span></div></div>
            </div>
        </div>

