        <div class="ftd-section">
            <div class="ftd-section-header"><h6 class="ftd-section-title">Other Process</h6></div>
            <hr class="ftd-section-line" />
            <div class="row g-2">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">AOP Type</span><span class="detail-value">@(Model.TblOtherProcess?.AopType)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">No. of Colors (Wash)</span><span class="detail-value">@(Model.TblOtherProcess?.NoOfColorW)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Repeat Size (Wash)</span><span class="detail-value">@(Model.TblOtherProcess?.RepeatSizeW)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">AOP Remarks</span><span class="detail-value">@(Model.TblOtherProcess?.AopRemarks)</span></div></div>
