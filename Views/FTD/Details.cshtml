            </div>
        </div>

        <!-- BRUSH PROCESS -->
        <div class="ftd-section">
            <div class="ftd-section-header"><h6 class="ftd-section-title">Brush Process</h6></div>
            <hr class="ftd-section-line" />
            <div class="row g-2">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Upper Pile</span><span class="detail-value">@(Model.TblBrush?.UPile)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Lower Pile</span><span class="detail-value">@(Model.TblBrush?.LPile)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Upper CP</span><span class="detail-value">@(Model.TblBrush?.UCp)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Lower CP</span><span class="detail-value">@(Model.TblBrush?.LCp)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Upper Drum Speed</span><span class="detail-value">@(Model.TblBrush?.UDrumSpeed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Lower Drum Speed</span><span class="detail-value">@(Model.TblBrush?.LDrumSpeed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Upper Tension</span><span class="detail-value">@(Model.TblBrush?.UTension)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Lower Tension</span><span class="detail-value">@(Model.TblBrush?.LTension)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Machine Speed</span><span class="detail-value">@(Model.TblBrush?.McSpeed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual Dia</span><span class="detail-value">@(Model.TblBrush?.ADia)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual GSM</span><span class="detail-value">@(Model.TblBrush?.AGsm)</span></div></div>
            </div>
        </div>

        <!-- COMPACTING PROCESS -->
        <div class="ftd-section">
            <div class="ftd-section-header"><h6 class="ftd-section-title">Compacting Process</h6></div>
            <hr class="ftd-section-line" />
            <div class="row g-2">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Temperature</span><span class="detail-value">@(Model.TblCompacting?.Temp)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Speed</span><span class="detail-value">@(Model.TblCompacting?.Speed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Over Feed</span><span class="detail-value">@(Model.TblCompacting?.OFeed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Compaction %</span><span class="detail-value">@(Model.TblCompacting?.CompactionPer)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Steam</span><span class="detail-value">@(Model.TblCompacting?.Steam)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual Dia</span><span class="detail-value">@(Model.TblCompacting?.ADia)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual GSM</span><span class="detail-value">@(Model.TblCompacting?.AGsm)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Finished GSM</span><span class="detail-value">@(Model.TblCompacting?.FGsm)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Required Dia</span><span class="detail-value">@(Model.TblCompacting?.RDia)</span></div></div>
