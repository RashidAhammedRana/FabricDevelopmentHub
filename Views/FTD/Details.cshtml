                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Temperature</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.Temp)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Speed</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.Speed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Over Feed</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.OFeed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Stretch %</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.StretchPer)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">P. Pressure 1</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.PPressure1)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">P. Pressure 2</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.PPressure2)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Chemical</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.Chemical)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Blower Speed</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.BlowerSpeed)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">NOC</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.Noc)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual Dia</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.ADia)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual GSM</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.AGsm)</span></div></div>
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"><div class="detail-item"><span class="detail-label">Actual Shrinkage</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.AShrinkage)</span></div></div>
                <div class="col-12"><div class="detail-item"><span class="detail-label">Comments</span><span class="detail-value">@(Model.TblFinishProcessStenteringBb?.Comments)</span></div></div>
            </div>
